{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echo",
  "version": "0.1.0",
  "identifier": "dk.volkan.clipper",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Echo",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "maximized": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://echoclip.link http://127.0.0.1:*",
        "media-src": "'self' asset: http://asset.localhost data: blob: http://127.0.0.1:*",
        "connect-src": "ipc: http://ipc.localhost 'self' asset: http://asset.localhost http://127.0.0.1:*",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$VIDEO/**",
            "$APPDATA/**",
            "$CONFIG/**",
            "$TEMP/**"
          ],
          "requireLiteralLeadingDot": false
        }
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Kimbo",
    "copyright": "© 2026 Kimbo",
    "shortDescription": "Echo - game clip recorder",
    "longDescription": "Echo records the last minutes of your games so you can save, edit and share clips."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwRDk3QzlDNzIzQzQ5NkYKUldSdlNUeHluSHpaWUhIc2d0NVR2cThJRXBISXh2aCtuUm5MTmRKTDBOT1FSVkRYRjNiZGxQK2QK",
      "endpoints": [
        "https://echoclip.link/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
