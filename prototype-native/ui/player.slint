// Player overlay, styled like Echo's #player: top bar with button groups, the video in a panel (.pwrap), the
// filmstrip seek bar with yellow trim handles (.pstrip), controls (.ctl) and the key hints (.phint).
// The Title / Tags / Note panel (#pside) sits on the RIGHT (chat 33).
// Positions are absolute: Rust needs the exact video rectangle (Windows window mode puts its own video window there)
// and the seek-preview rectangle (cut out of that window so the preview shows above the video).
import { Cm, CloudMenuBody } from "cloud.slint";
import { T, Ic, Icon, TipArea, IconBtn, Btn, Kbd, Toast, CopyMenuBody, MenuRow } from "theme.slint";
import { OverStill } from "over.slint"; // r2-layout (L1): still picture while a menu covers the video
import { Focus } from "focus.slint"; // port leftovers L2 / L33
import { PlayGlyph } from "playbadge.slint"; // the play triangle shared with Home

export global Play {
    in-out property <string> title;
    in-out property <bool> paused;
    in-out property <float> progress;      // 0..1, Rust sends where it will be at the NEXT poll (250 ms ahead)
    in-out property <bool> snap;           // true = jump there now (open / seek / pause), false = glide
    in-out property <float> duration;      // seconds
    in-out property <string> time-text;
    in-out property <string> dur-text;
    in-out property <string> stats;
    in-out property <bool> show-stats;     // the codec / decoder / frames line (ECHO_STATS=1; hidden for now)
    in-out property <image> frame;
    in-out property <image> poster;        // the clip's thumbnail, shown until the video's first picture
    in-out property <bool> poster-on;
    in-out property <bool> tick;           // flips on each new video frame (Slint repaints the borrowed texture)
    in-out property <bool> fav;
    in-out property <[string]> tags;
    in-out property <string> note;
    in-out property <string> info;         // details under the note
    in-out property <[string]> info-chips; // the same as chips in the side panel: size, 1080p60, codec, date (11 Nov 2026)
    in-out property <string> size-text;
    in-out property <bool> has-prev;
    in-out property <bool> has-next;
    in-out property <image> sheet;         // 60 pictures (10 x 6): filmstrip + seek preview
    in-out property <bool> sheet-ok;
    in-out property <int> sheet-tw;
    in-out property <int> sheet-th;
    // the sheet's 60 pictures as small images (sheet_tiles.rs): the filmstrip + seek preview draw THESE, never
    // cut-outs of the whole sheet - each Image item uploaded its own copy of it (~400 MB of VRAM, 11 Nov 2026)
    in-out property <[image]> tiles;
    // quick trim (the yellow ends of the strip)
    in-out property <bool> trimming;
    in-out property <float> t0: 0;         // fractions of the clip
    in-out property <float> t1: 1;
    in-out property <bool> exact;
    in-out property <bool> busy;           // saving a trimmed copy
    in-out property <bool> gif-busy;       // L14: a GIF of the selection is being made (Echo: trim.busy + #tgif disabled)
    // 9 Nov: cut out middle parts on the strip - Shift+drag highlights (h0..h1), X cuts it; cuts = flat
    // [a0, b0, a1, b1, ...] fractions, skipped while playing, left out of Save copy, carried into the editor (E)
    in-out property <float> h0: -1;
    in-out property <float> h1: -1;
    in-out property <[float]> cuts;
    in-out property <float> cut-sum;       // how much of the clip the cuts take (a fraction; the trim bar's length)
    callback cut();                       // cut the highlight
    callback uncut(int);                   // put cut k back
    // sound + fullscreen
    in-out property <float> volume: 1;
    in-out property <bool> muted;
    // M / the mute button: un-muting with the volume at 0 sets it to 0.5 (Echo's pmute)
    public function toggle-mute() {
        self.muted = !self.muted;
        if (!self.muted && self.volume <= 0) {
            self.volume = 0.5;
        }
        self.set-volume(self.volume, self.muted);
    }
    in-out property <bool> full;
    in-out property <bool> video-window;
    in-out property <bool> overlay-ok: true;
    in-out property <bool> pv-mpv;            // Windows flip model: mpv draws the seek preview over the video (normal view)
    in-out property <bool> mpv-osd;           // fullscreen controls are drawn by mpv (Slint's stay invisible, for the mouse)  // controls may be drawn over the video (false: Windows window mode)    // Windows window mode: in fullscreen the video is a window BEHIND this one
    // 11 Nov 2026: the clip plays INSIDE Home's picture (video + strip + bar there; no dim, top row, side card or
    // arrows); fullscreen works as usual and comes back to Home
    in-out property <bool> inline;
    // 12 Nov 2026: Home's clip sits loaded + paused in its picture; true once it's played there (Esc / a click
    // outside: back to paused at Home's frame). Until then Home keeps its own keys.
    in-out property <bool> inline-active;
    in-out property <bool> ui-on: true;     // fullscreen: strip + controls visible (Rust cuts them out of the video window)
    in-out property <float> speed: 1;       // playback speed (the bar's SPEED menu, 11 Nov 2026)
    callback close();
    callback toggle-pause();
    callback seek(float, bool);            // fraction, still dragging
    callback seek-rel(float);
    callback prev();
    callback next();
    callback toggle-fav();
    callback add-tag(string);
    // gaps-player (row 45): existing tags matching what's typed in the Tags box (Echo's datalist)
    in-out property <[string]> tag-hints;
    callback tag-typed(string);
    callback tag-blur(string);             // the Tags box lost focus with text in it (added if still the same clip)
    callback remove-tag(string);
    callback note-edited(string);
    callback act(string);                  // "folder" / "copy" / "copy:<size>" / "share" / "cloud" / "edit" / "frame" / "thumb" / "audio" / "delete" / "gif" / "replace"
    callback trim-changed(bool);           // the selection moved (true = still dragging)
    callback trim-cancel();
    callback trim-save();
    callback set-volume(float, bool);      // volume 0..1, muted
    callback toggle-full();
    // Chat A: wheel zoom + pan (pl_zoom.rs), bookmarks (seconds) from <stem>.marks.json
    callback zoom(float, float, float);    // +1 in / -1 out, mouse x / y as 0..1 of the video
    callback pan(float, float);
    in-out property <bool> zoomed;
    in-out property <[float]> marks;
    // gaps-cloud (rows 4-6, cloud_live.rs): a cloud-only clip (Title read-only), Echo's #pload overlay while it
    // streams in / downloads, and the #pup / #puplbl upload bar + line while this clip uploads
    in-out property <bool> cloud-only;
    in-out property <bool> cl-on;
    in-out property <string> cl-title;
    in-out property <string> cl-sub;
    in-out property <float> cl-pct: -1;    // 0..1, < 0 = moving bar (nothing known yet)
    in-out property <bool> up-on;
    in-out property <float> up-pct;        // 0..1
    in-out property <string> up-text;
}

// time formats (Slint 1.18 has no top-level functions: a global holds them)
global Fmt {
    // m:ss.d (trim times)
    public pure function t1(s: float) -> string {
        let t = round(max(0, s) * 10);
        let m = floor(t / 600);
        let sec = floor(mod(t, 600) / 10);
        return m + ":" + (sec < 10 ? "0" : "") + sec + "." + mod(t, 10);
    }
    // m:ss
    public pure function t0(s: float) -> string {
        let t = round(max(0, s));
        return floor(t / 60) + ":" + (mod(t, 60) < 10 ? "0" : "") + mod(t, 60);
    }
}

// Echo's .tchip with an x (side panel)
component TagChip inherits Rectangle {
    in property <string> text;
    callback remove();
    height: 24px;
    width: hl.preferred-width;
    border-radius: 12px;
    background: T.accent.with-alpha(0.15);
    border-width: 1px;
    border-color: T.accent.with-alpha(0.33);
    hl := HorizontalLayout {
        padding-left: 9px;
        padding-right: 5px;
        spacing: 3px;
        Text {
            text: "#" + root.text;
            font-size: 12px;
            color: T.accent2;
            vertical-alignment: center;
        }
        Rectangle {
            width: 16px;
            height: 16px;
            y: 4px;
            border-radius: 8px;
            background: xta.has-hover ? #ffffff22 : transparent;
            xta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.remove(); }
            }
            TipArea {
                text: "Remove tag";
                hover: xta.has-hover;
            }
            Icon {
                width: 10px;
                height: 10px;
                commands: Ic.x;
                stroke: T.accent2;
                stroke-width: 2.4px;
            }
        }
    }
}

// Echo's .pnav
component NavArrow inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    callback clicked;
    width: 46px;
    height: 46px;
    border-radius: 23px;
    border-width: 1px;
    border-color: T.line;
    background: ta.has-hover ? #26262e : #17171ccc;
    animate background { duration: T.fade; enabled: !T.rgb-live; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    TipArea {
        text: root.tip;
        hover: ta.has-hover;
    }
    Icon {
        width: 22px;
        height: 22px;
        commands: root.icon;
        stroke: white;
        transform-scale: ta.pressed ? 0.85 : 1;
        animate transform-scale { duration: 90ms; }
    }
}

// ---- the player bar (11 Nov 2026): plain icons, hover only - no boxes, no glow ----
global Ic2 {
    // rounded-corner fullscreen frames (Ic.fs had sharp corners)
    out property <string> fs: "M4 9V6.5A2.5 2.5 0 0 1 6.5 4H9 M15 4h2.5A2.5 2.5 0 0 1 20 6.5V9 M20 15v2.5a2.5 2.5 0 0 1-2.5 2.5H15 M9 20H6.5A2.5 2.5 0 0 1 4 17.5V15";
    out property <string> unfs: "M9 4v2.5A2.5 2.5 0 0 1 6.5 9H4 M15 4v2.5A2.5 2.5 0 0 0 17.5 9H20 M20 15h-2.5a2.5 2.5 0 0 0-2.5 2.5V20 M4 15h2.5A2.5 2.5 0 0 1 9 17.5V20";
    // rounded speaker (Ic.vol was a sharp box + cone)
    out property <string> vol: "M3 10a1 1 0 0 1 1-1h2.6l4.2-3.5a.7.7 0 0 1 1.2.5v12a.7.7 0 0 1-1.2.5L6.6 15H4a1 1 0 0 1-1-1z M15.5 8.8a4.5 4.5 0 0 1 0 6.4 M18.4 6a8.5 8.5 0 0 1 0 12";
    out property <string> vol1: "M3 10a1 1 0 0 1 1-1h2.6l4.2-3.5a.7.7 0 0 1 1.2.5v12a.7.7 0 0 1-1.2.5L6.6 15H4a1 1 0 0 1-1-1z M15.5 8.8a4.5 4.5 0 0 1 0 6.4";
    out property <string> mute: "M3 10a1 1 0 0 1 1-1h2.6l4.2-3.5a.7.7 0 0 1 1.2.5v12a.7.7 0 0 1-1.2.5L6.6 15H4a1 1 0 0 1-1-1z M15.8 9.5l4.6 5 M20.4 9.5l-4.6 5";
}
// a bar icon: 20 px in 34 px, theme colour (white in fullscreen), soft round hover, no box when on (just the colour)
component Cb inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    in property <bool> on;
    callback clicked;
    property <color> fg: Play.full ? #ffffff : T.text;
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background: ta.has-hover ? root.fg.with-alpha(0.08) : transparent;
    animate background { duration: 120ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    TipArea {
        text: root.tip;
        hover: ta.has-hover;
    }
    Icon {
        width: 20px;
        height: 20px;
        commands: root.icon;
        stroke: root.on ? T.accent2 : ta.has-hover ? root.fg : root.fg.with-alpha(0.82);
        transform-scale: ta.pressed ? 0.88 : 1;
        animate transform-scale { duration: 90ms; }
    }
}
// play / pause: the shared glyph (Home's optically centred triangle) in the text colour, a soft round hover - no disc
component BarPlay inherits Rectangle {
    property <color> fg: Play.full ? #ffffff : T.text;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: ta.has-hover ? root.fg.with-alpha(0.08) : transparent;
    animate background { duration: 120ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Play.toggle-pause(); }
    }
    TipArea {
        text: Play.paused ? "Play (Space)" : "Pause (Space)";
        hover: ta.has-hover;
    }
    // paused: Home's play triangle; playing: two crisp 3 px bars, 4 px apart (the glyph's pause blurred into one block)
    if Play.paused: PlayGlyph {
        width: 22px;
        height: 22px;
        paused: false;
        colour: root.fg;
        transform-scale: ta.pressed ? 0.88 : 1;
        animate transform-scale { duration: 90ms; }
    }
    if !Play.paused: Rectangle {
        width: 10px;
        height: 14px;
        transform-scale: ta.pressed ? 0.88 : 1;
        Rectangle { x: 0; width: 3px; border-radius: 1px; background: root.fg; }
        Rectangle { x: 7px; width: 3px; border-radius: 1px; background: root.fg; }
    }
}
component SpeedMenu inherits Rectangle {
    callback picked;
    background: T.panel;
    border-radius: 12px;
    border-width: 1px;
    border-color: T.line;
    drop-shadow-blur: 30px;
    drop-shadow-offset-y: 10px;
    drop-shadow-color: #00000070;
    width: 148px;
    height: sl.preferred-height;
    sl := VerticalLayout {
        padding: 6px;
        spacing: 1px;
        Text {
            text: "   SPEED";
            font-size: 11px;
            font-weight: 600 + T.fw;
            letter-spacing: 0.9px;
            color: T.dim;
            height: 24px;
            vertical-alignment: center;
        }
        for s in [0.25, 0.5, 0.75, 1, 1.25, 1.5, 2]: Rectangle {
            height: 30px;
            border-radius: 8px;
            background: Play.speed == s ? T.accent.with-alpha(0.18) : rta.has-hover ? T.text.with-alpha(0.07) : transparent;
            rta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Play.speed = s;
                    root.picked();
                    Play.act("speed:" + s);
                }
            }
            Text {
                x: 12px;
                text: s + "×";
                font-size: 13px;
                font-weight: (Play.speed == s ? 600 : 400) + T.fw;
                color: T.text;
            }
            if s == 1: Text {
                x: parent.width - self.width - 12px;
                text: "normal";
                font-size: 12px;
                color: T.muted;
            }
        }
    }
}
// "1x": plain text, no box (hover only); opens the speed menu
component SpeedTxt inherits Rectangle {
    property <color> fg: Play.full ? #ffffff : T.text;
    width: max(34px, st.preferred-width + 16px);
    height: 34px;
    border-radius: 17px;
    background: ta.has-hover ? root.fg.with-alpha(0.08) : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { spop.show(); }
    }
    TipArea {
        text: "Playback speed";
        hover: ta.has-hover;
    }
    // "SPEED 1.00×"
    st := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        Text {
            text: "SPEED";
            font-size: 10px;
            font-weight: 600 + T.fw;
            letter-spacing: 1.4px;
            color: Play.full ? #bbbbbb : T.muted;
            vertical-alignment: center;
        }
        Text {
            text: Play.speed.to-fixed(2) + "×";
            font-family: "Cascadia Mono";
            font-size: 13px;
            font-weight: 600 + T.fw;
            color: Play.speed != 1 ? T.accent2 : ta.has-hover ? root.fg : root.fg.with-alpha(0.92);
            vertical-alignment: center;
        }
    }
    // a real popup: a plain rectangle would sit BEHIND the video window on Windows
    spop := PopupWindow {
        x: (root.width - self.width) / 2;
        y: - self.height - 10px;
        width: sm.width;
        height: sm.height;
        close-policy: close-on-click-outside;
        sm := SpeedMenu {
            picked => { spop.close(); }
        }
    }
}
// "VOL" label - a click mutes / unmutes ("MUTED" while muted)
component VolLbl inherits Rectangle {
    width: t.preferred-width + 8px;
    height: 34px;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Play.toggle-mute(); }
    }
    TipArea {
        text: Play.muted ? "Unmute (M)" : "Mute (M)";
        hover: ta.has-hover;
    }
    t := Text {
        x: 4px;
        text: Play.muted ? "MUTED" : "VOL";
        font-size: 10px;
        font-weight: 600 + T.fw;
        letter-spacing: 1.4px;
        color: Play.muted ? T.accent2 : ta.has-hover ? (Play.full ? #ffffff : T.text) : (Play.full ? #bbbbbb : T.muted);
        vertical-alignment: center;
    }
}


// Echo's .din box with a text field inside (TextInput styled by hand: the std widgets look like Fluent, not Echo)
component DinField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> multi;
    in property <bool> read-only;
    callback accepted(string);
    callback edited(string);
    callback focus-out(string);     // the field lost focus (Tags: the typed tag is added, like Echo's onblur)
    public function open-box() { ti.focus(); } // "+ Tag" / "+ Add a note" open the box
    background: T.panel2;
    border-radius: 9px;
    border-width: 1px;
    border-color: ti.has-focus ? T.accent : T.line;
    height: multi ? 110px : 36px;
    clip: true;
    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { ti.focus(); }
    }
    if root.text == "" && !ti.has-focus: Text {
        x: 11px;
        y: 9px;
        text: root.placeholder;
        font-size: 13.5px;
        color: T.dim;
    }
    ti := TextInput {
        x: 11px;
        y: 9px;
        width: parent.width - 22px;
        height: parent.height - 18px;
        text <=> root.text;
        read-only: root.read-only;
        single-line: !root.multi;
        wrap: root.multi ? word-wrap : no-wrap;
        font-size: 13.5px;
        color: T.text;
        selection-background-color: T.accent.with-alpha(0.45);
        selection-foreground-color: T.text;
        vertical-alignment: top;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
        changed has-focus => {
            if (!self.has-focus) {
                root.focus-out(self.text);
            }
        }
    }
}

// a small checkbox (Echo's label.chk)
// L16: Echo's <label class="chk">: the box AND its text are clickable, the label's title shows as a tooltip.
// (A HorizontalLayout gave the TouchArea its own cell beside the text, so neither the box nor "Exact" took a click.)
component Check inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <string> tip;
    width: hl.preferred-width;
    hl := HorizontalLayout {
        spacing: 6px;
        Rectangle {
            y: (parent.height - 16px) / 2;
            width: 16px;
            height: 16px;
            border-radius: 4px;
            border-width: 1.5px;
            border-color: root.checked ? T.accent : T.muted;
            background: root.checked ? T.accent : transparent;
            if root.checked: Icon {
                width: 12px;
                height: 12px;
                commands: Ic.check;
                stroke: T.on-accent;
                stroke-width: 3px;
            }
        }
        Text {
            text: root.text;
            font-size: 12.5px;
            color: T.muted;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; }
    }
    TipArea {
        text: root.tip;
        hover: ta.has-hover && !ta.pressed;
    }
}

// ---- side panel parts (11 Nov 2026) ----
// "+ Tag": a dashed round chip
component AddChip inherits Rectangle {
    in property <string> text;
    callback clicked;
    width: al.preferred-width;
    height: 24px;
    border-radius: 12px;
    border-width: 1px;
    border-color: ta.has-hover ? T.muted : T.line;
    background: ta.has-hover ? T.text.with-alpha(0.06) : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    al := HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 4px;
        alignment: center;
        Icon {
            y: 6px;
            width: 12px;
            height: 12px;
            commands: "M12 5v14 M5 12h14";
            stroke: T.muted;
        }
        Text {
            text: root.text;
            font-size: 12px;
            color: T.muted;
            vertical-alignment: center;
        }
    }
}
// "+ Add a note": a plain row
component AddRow inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 26px;
    border-radius: 7px;
    background: ta.has-hover ? T.text.with-alpha(0.06) : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 3px;
        spacing: 7px;
        Icon {
            y: 6.5px;
            width: 13px;
            height: 13px;
            commands: "M12 5v14 M5 12h14";
            stroke: ta.has-hover ? T.text : T.muted;
        }
        Text {
            text: root.text;
            font-size: 12.5px;
            color: ta.has-hover ? T.text : T.muted;
            vertical-alignment: center;
        }
    }
}
// a detail chip: "3:00", "205.4 MB", "1080p60", "AV1", "11 Nov · 17:43"
component InfoChip inherits Rectangle {
    in property <string> text;
    width: it.preferred-width + 18px;
    height: 22px;
    border-radius: 11px;
    background: T.text.with-alpha(0.05);
    it := Text {
        text: root.text;
        font-size: 11.5px;
        color: T.muted;
        vertical-alignment: center;
    }
}
// Copy / Share in the panel: fills the width it gets (Btn wouldn't shrink: Share stuck out of the card).
// part: "" / "left" / "right" (the Copy split). ctrl = Ctrl was held on the last press (Ctrl+click Copy = size menu).
component PanelBtn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> tip;
    in property <bool> primary;
    in property <string> part;
    out property <bool> ctrl;
    callback clicked;
    min-width: 26px;
    height: 36px;
    border-top-left-radius: root.part == "right" ? 3px : 9px;
    border-bottom-left-radius: root.part == "right" ? 3px : 9px;
    border-top-right-radius: root.part == "left" ? 3px : 9px;
    border-bottom-right-radius: root.part == "left" ? 3px : 9px;
    background: root.primary ? (ta.pressed ? T.accent.darker(0.12) : ta.has-hover ? T.accent2 : T.accent) : (ta.pressed ? T.text.with-alpha(0.14) : ta.has-hover ? T.text.with-alpha(0.11) : T.text.with-alpha(0.07));
    animate background { duration: 100ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.ctrl = e.modifiers.control;
            }
        }
        clicked => { root.clicked(); }
    }
    TipArea {
        text: root.tip;
        hover: ta.has-hover;
    }
    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        Icon {
            y: (root.height - 15px) / 2;
            width: 15px;
            height: 15px;
            commands: root.icon;
            stroke: root.primary ? T.on-accent : T.text;
        }
        if root.text != "": Text {
            text: root.text;
            font-size: 13px;
            font-weight: 600 + T.fw;
            color: root.primary ? T.on-accent : T.text;
            vertical-alignment: center;
        }
    }
}
// an action tile in the panel's grid: icon over a small label; hover lighter; Trim yellow while trimming; Delete red
component ActTile inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <string> tip;
    in property <bool> active;
    in property <bool> red;
    callback clicked;
    property <color> fg: root.red ? #ff6b6b : root.active ? T.hi-text : T.text;
    min-width: 36px;
    height: 52px;
    border-radius: 9px;
    border-width: root.active ? 1px : 0px;
    border-color: T.hi-text.with-alpha(0.6);
    background: ta.pressed ? T.text.with-alpha(0.12) : ta.has-hover ? T.text.with-alpha(0.09) : T.text.with-alpha(0.04);
    animate background { duration: 100ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    TipArea {
        text: root.tip;
        hover: ta.has-hover;
    }
    Icon {
        y: 9px;
        width: 17px;
        height: 17px;
        commands: root.icon;
        stroke: root.fg.with-alpha(ta.has-hover || root.active ? 1 : 0.88);
    }
    Text {
        y: 31px;
        width: parent.width;
        text: root.text;
        font-size: 10.5px;
        color: root.red ? #ff6b6b : root.active ? T.hi-text : ta.has-hover ? T.text : T.muted;
        horizontal-alignment: center;
    }
}

export component PlayerView inherits Rectangle {
    // the video rectangle (computed by the window, which also hands it to Rust)
    in property <length> vx;
    in property <length> vy;
    in property <length> vw;
    in property <length> vh;
    // the side panel
    in property <length> side-x;
    in property <length> side-w;
    in property <bool> side-on;
    // the seek preview, for Rust (Windows window mode cuts it out of the video window)
    out property <bool> preview-on: (sa.has-hover || seek.drag != "") && Play.sheet-ok;
    // pv-in (Windows flip model, normal view): mpv draws the preview over the video and Slint the rest - two renderers
    // with different timing, so a part sticking out below / beside the video lagged behind on fast mouse moves.
    // Keep the whole preview INSIDE the video there (4 px higher, clamped to the video's sides) = only mpv's copy shows.
    property <bool> pv-in: Play.pv-mpv && !Play.full;
    out property <length> preview-x: pv-in
        ? clamp(seek.x + seek.width * seek.hover - pw / 2, root.vx + 4px, max(root.vx + 4px, root.vx + root.vw - pw - 4px))
        : clamp(seek.x + seek.width * seek.hover - pw / 2, 4px, root.width - pw - 4px);
    out property <length> preview-y: pv-in ? root.vy + root.vh - ph - 4px : seek.y - ph - 10px;
    out property <length> pw: 228px;
    out property <length> ph: 132px;
    // for the controls mpv draws: where the play head is (gliding) and which picture the preview shows
    out property <float> shown-frac: seek.shown;
    out property <float> hover-frac: seek.drag == "seek" ? seek.drag-frac : seek.drag == "t0" ? Play.t0 : seek.drag == "t1" ? Play.t1 : seek.hover;
    property <length> strip-h: 66px;
    property <length> ctl-h: 57px;
    // top of the strip: under the video, or (fullscreen) over the bottom of the video
    property <length> bar-y: Play.full && Play.overlay-ok ? root.vy + root.vh - strip-h - ctl-h : root.vy + root.vh;
    // fullscreen: strip + controls show while the mouse moves and hide when it rests / leaves (YouTube-style)
    property <bool> show-ui: !Play.full || !Play.overlay-ok || Play.ui-on;
    // (showing / hiding them is decided in Rust from the window's own mouse events: Slint's hover only knows the
    // topmost item, so moving onto the strip looked like "the mouse left" and made them blink)
    // fullscreen + Windows window mode: clear, the video window sits behind Slint's window
    background: Play.full ? (Play.video-window ? transparent : black) : transparent;
    // 10 Nov: the window's title bar (top-h tall) stays lit and live with a clip open - the dim layer, the
    // "click beside = close" area and the key scope all start below it (fullscreen: the whole window as before)
    in property <length> top-h: 52px;
    property <length> dim-y: Play.full || inl ? 0 : root.top-h;
    // playing inside Home's picture (not fullscreen)
    property <bool> inl: Play.inline && !Play.full;

    public function take-focus() {
        fs.focus();
    }

    if !Play.full && !inl: Rectangle {
        y: root.dim-y;
        height: root.height - root.dim-y;
        // QA B34 (11 Nov 2026): a light page showed through 73 % (its header ran into the clip's title, its text
        // under the side panel) - light themes (text #16161c, settings.rs theme_vars) get 90 %
        background: T.text == #16161c ? #0b0b0fe6 : #0b0b0fbb;
    }
    // click beside the video = close (not inside Home's picture)
    if !inl: TouchArea {
        y: root.dim-y;
        height: root.height - root.dim-y;
        clicked => {
            if (!Play.full) {
                Play.close();
            }
        }
    }
    // (below the title bar too: an unfocused FocusScope eats the first click to take focus - that was Record / Save clip)
    fs := FocusScope {
        y: root.dim-y;
        height: root.height - root.dim-y;
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                if (Play.h0 >= 0) {
                    Play.h0 = -1;
                    Play.h1 = -1;
                } else if (Play.full) {
                    Play.toggle-full();
                } else if (inl) {
                    Play.act("inline-stop"); // Home: back to the paused frame
                } else {
                    Play.close();
                }
                return accept;
            }
            if (e.text == " ") {
                Play.toggle-pause();
                return accept;
            }
            // YouTube-style K = play / pause (Echo's KeyK)
            if (e.text == "k" || e.text == "K") {
                Play.toggle-pause();
                return accept;
            }
            // ← / → in Home's picture (not fullscreen): Home's other clips, always (William, 12 Nov 2026). Everywhere else
            // they seek 5 s (Ctrl 2.5 s); Home's player in fullscreen also goes to Home's previous / next clip with a
            // press at the very start / end (main.rs seek-rel)
            if (inl && (e.text == Key.LeftArrow || e.text == Key.RightArrow)) {
                if (e.text == Key.LeftArrow) { Play.prev(); } else { Play.next(); }
                return accept;
            }
            if (e.text == Key.LeftArrow) {
                if (e.modifiers.shift) {
                    Play.prev();
                } else {
                    Play.seek-rel(e.modifiers.control ? -2.5 : -5);
                }
                return accept;
            }
            if (e.text == Key.RightArrow) {
                if (e.modifiers.shift) {
                    Play.next();
                } else {
                    Play.seek-rel(e.modifiers.control ? 2.5 : 5);
                }
                return accept;
            }
            if (e.text == "j" || e.text == "J") {
                Play.seek-rel(-10);
                return accept;
            }
            if (e.text == "l" || e.text == "L") {
                Play.seek-rel(10);
                return accept;
            }
            if (e.text == "m" || e.text == "M") {
                Play.toggle-mute();
                return accept;
            }
            if (e.text == "t" || e.text == "T") {
                if (Play.trimming) {
                    Play.trim-cancel();
                } else {
                    Play.trimming = true;
                    Play.trim-changed(false);
                }
                return accept;
            }
            // Chat A: I / O = trim start / end at the play head (starts trimming)
            if (e.text == "i" || e.text == "I") {
                Play.trimming = true;
                Play.t0 = clamp(Play.progress, 0, Play.t1 - 0.01);
                Play.trim-changed(false);
                return accept;
            }
            if (e.text == "o" || e.text == "O") {
                Play.trimming = true;
                Play.t1 = clamp(Play.progress, Play.t0 + 0.01, 1);
                Play.trim-changed(false);
                return accept;
            }
            if (e.text == "f" || e.text == "F") {
                Play.toggle-full();
                return accept;
            }
            // 9 Nov: S at two spots = cut out the part between (first S marks the play head, second cuts)
            if (e.text == "s" || e.text == "S") {
                if (Play.h0 < 0) {
                    Play.h0 = Play.progress;
                    Play.h1 = Play.progress;
                } else {
                    Play.h1 = Play.progress;
                    Play.cut();
                }
                return accept;
            }
            if ((e.text == "x" || e.text == "X") && Play.h0 >= 0) {
                Play.cut();
                return accept;
            }
            if (e.text == "e" || e.text == "E") {
                Play.act("edit");
                return accept;
            }
            if (e.text == "p" || e.text == "P") {
                Play.act("frame");
                return accept;
            }
            if (e.text == Key.Delete) {
                Play.act("delete");
                return accept;
            }
            reject
        }
    }

    // ---- top bar (#player .bar): title, then groups: share · edit · file, Close ----
    // clicks on the bar's empty space aren't "beside the video" (behind the row: inside it, this took a stretchy slot
    // and pushed the clip name toward the middle - 9 Nov)
    if !Play.full && !inl: TouchArea {
        x: root.vx;
        y: root.vy - 50px;
        width: root.vw;
        height: 36px;
    }
    // 11 Nov 2026: with the side panel on, every action is in the panel - the top keeps the title and a ✕
    if !Play.full && !inl && root.side-on: HorizontalLayout {
        x: root.vx;
        y: root.vy - 50px;
        width: root.vw;
        height: 36px;
        spacing: 6px;
        Text {
            text: Play.title;
            font-size: 15px;
            font-weight: 600 + T.fw;
            color: #f5f5f7;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-width: 140px;
        }
        Btn {
            icon: Ic.x;
            tip: "Close (Esc)";
            clicked => { Play.close(); }
        }
    }
    if !Play.full && !inl && !root.side-on: HorizontalLayout {
        x: root.vx;
        y: root.vy - 50px;
        width: root.vw;
        height: 36px;
        spacing: 6px;
        Text {
            text: Play.title;
            font-size: 15px;
            font-weight: 600 + T.fw;
            // QA B34 (11 Nov 2026): it sits on the dark dim layer in every theme - near-black (the Light theme's
            // text colour) melted into the dimmed page header behind it
            color: #f5f5f7;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-width: 140px;
        }
        copy := HorizontalLayout {
            spacing: 0;
            Btn {
                text: "Copy";
                icon: Ic.copy;
                left-half: true;
                tip: "Copy (Ctrl+click: choose size)";
                clicked => {
                    if (self.ctrl) {
                        cm.show();
                    } else {
                        Play.act("copy");
                    }
                }
            }
            Btn {
                icon: Ic.down;
                right-half: true;
                tip: "Copy smaller for Discord";
                clicked => { cm.show(); }
            }
            cm := PopupWindow {
                x: 0;
                y: 42px;
                // own size: Slint tests clicks against it (none = every click 'outside', fell through)
                width: cmb.preferred-width;
                height: cmb.preferred-height;
                close-policy: close-on-click-outside;
                cmb := CopyMenuBody {
                    size-text: Play.size-text;
                    picked(k) => {
                        cm.close();
                        Play.act("copy:" + k);
                        fs.focus();
                    }
                    cancel => {
                        cm.close();
                        fs.focus();
                    }
                }
            }
        }
        sharebtn := Btn {
            text: "Share";
            icon: Ic.share;
            tip: "Upload and copy a link that plays in Discord";
            clicked => {
                Cm.open = false;
                Play.act("share");
                if (Cm.open) {
                    Cm.open = false;
                    sharepop.show();
                }
            }
        }
        sharepop := PopupWindow {
            // drops down from the button's left edge, just below it (like the Copy menu)
            x: sharebtn.x;
            y: sharebtn.y + sharebtn.height + 6px;
            // own size: Slint tests clicks against it (none = every click 'outside')
            width: sharepopb.preferred-width;
            height: sharepopb.preferred-height;
            close-policy: close-on-click-outside;
            sharepopb := CloudMenuBody {
                done => { sharepop.close(); }
            }
        }
        cloudbtn := Btn {
            icon: Ic.cloud;
            tip: "Cloud: upload, free up space, download, delete";
            clicked => {
                Cm.open = false;
                Play.act("cloud");
                if (Cm.open) {
                    Cm.open = false;
                    cloudpop.show();
                }
            }
        }
        cloudpop := PopupWindow {
            // drops down from the button's left edge, just below it (like the Copy menu)
            x: cloudbtn.x;
            y: cloudbtn.y + cloudbtn.height + 6px;
            // own size: Slint tests clicks against it (none = every click 'outside')
            width: cloudpopb.preferred-width;
            height: cloudpopb.preferred-height;
            close-policy: close-on-click-outside;
            cloudpopb := CloudMenuBody {
                done => { cloudpop.close(); }
            }
        }
        // group divider
        Rectangle {
            width: 23px;
            Rectangle {
                x: 10px;
                width: 1px;
                y: 4px;
                height: parent.height - 8px;
                background: T.line;
            }
        }
        Btn {
            text: "Trim";
            icon: Ic.trim;
            active: Play.trimming;
            tip: "Trim (T)";
            clicked => {
                if (Play.trimming) {
                    Play.trim-cancel();
                } else {
                    Play.trimming = true;
                    Play.trim-changed(false);
                }
            }
        }
        Btn {
            text: "Edit";
            icon: Ic.edit;
            tip: "Open in editor (E)";
            clicked => { Play.act("edit"); }
        }
        Btn {
            icon: Ic.frame;
            tip: "Save this frame as a picture + copy it (P)";
            clicked => { Play.act("frame"); }
        }
        Btn {
            icon: Ic.image;
            tip: "Use this frame as the clip's thumbnail";
            clicked => { Play.act("thumb"); }
        }
        mp3btn := Btn {
            icon: Ic.music;
            tip: "Save the sound as MP3 or WAV + copy it";
            clicked => { mp3pop.show(); }
        }
        // Echo's MP3 popup: two rows, just below the button
        mp3pop := PopupWindow {
            x: mp3btn.x;
            y: mp3btn.y + mp3btn.height + 4px;
            width: 230px;
            height: mp3l.preferred-height;
            close-policy: close-on-click-outside;
            Rectangle {
                background: T.panel;
                border-radius: 12px;
                border-width: 1px;
                border-color: T.line;
                drop-shadow-blur: 40px;
                drop-shadow-offset-y: 14px;
                drop-shadow-color: #000000aa;
                TouchArea { }
            }
            mp3l := VerticalLayout {
                padding: 6px;
                MenuRow {
                    text: "Save as MP3";
                    clicked => {
                        mp3pop.close();
                        Play.act("audio");
                        fs.focus();
                    }
                }
                MenuRow {
                    text: "Save as WAV (sound effects)";
                    clicked => {
                        mp3pop.close();
                        Play.act("wav");
                        fs.focus();
                    }
                }
            }
        }
        Rectangle {
            width: 23px;
            Rectangle {
                x: 10px;
                width: 1px;
                y: 4px;
                height: parent.height - 8px;
                background: T.line;
            }
        }
        Btn {
            icon: Ic.folder;
            tip: "Show in folder";
            clicked => { Play.act("folder"); }
        }
        Btn {
            icon: Ic.del;
            red: true;
            danger: true;
            tip: "Delete (Del)";
            clicked => { Play.act("delete"); }
        }
        Rectangle { width: 4px; }
        Btn {
            text: "Close";
            clicked => { Play.close(); }
        }
    }
    // ---- .pwrap: video + strip + controls in one panel ----
    if !Play.full: Rectangle {
        x: root.vx - (Play.full ? 0 : 1px);
        y: root.vy - (Play.full ? 0 : 1px);
        width: root.vw + (Play.full ? 0 : 2px);
        height: root.vh + root.strip-h + root.ctl-h + (Play.full ? 0 : 2px);
        background: T.panel;
        border-width: Play.full ? 0 : 1px;
        // like Medal: a faint white outline so the popup's edges read clearly against the dimmed library -
        // one outline around video + strip + controls (no separate video / bar boxes)
        border-color: #ffffff26;
        border-radius: Play.full ? 0 : 12px;
        // softer (11 Nov 2026): 80 % black pushed 20 px down read as a hard black band under the player
        drop-shadow-blur: Play.full || inl ? 0 : 36px;
        drop-shadow-offset-y: Play.full ? 0 : 8px;
        drop-shadow-color: #00000073;
        TouchArea { } // inside the player panel: not "beside the video"
    }
    // the video
    Rectangle {
        x: root.vx;
        y: root.vy;
        width: root.vw;
        height: root.vh;
        background: Play.full && Play.video-window ? transparent : black;
        // one radius for all corners: a per-corner radius + clip draws through a cached layer -> stale/black video
        border-radius: Play.full ? 0 : 11px;
        clip: true;
        Image {
            x: 0;
            y: 0;
            // same texture, new content: an invisible change makes Slint redraw it. (NOT opacity 1.0/0.999 like
            // chat 32: opacity < 1 draws through a cached layer, so every other frame showed an old picture)
            width: parent.width - (Play.tick ? 0px : 0.01px);
            height: parent.height;
            source: Play.frame;
            image-fit: fill;
        }
        // opening a clip: its thumbnail instead of black / the previous clip's last picture
        if Play.poster-on: Rectangle {
            background: black;
            Image {
                width: parent.width;
                height: parent.height;
                source: Play.poster;
                image-fit: contain;
            }
        }
        // r2-layout (L1): Windows - the video window is parked while a menu covers it; its picture stays here
        OverStill { }
        // gaps-cloud (row 5): Echo's #pload - "Loading from the cloud…" / "Downloading from the cloud…" + a bar along
        // the bottom of the video (Windows window mode: main.rs parks mpv's window meanwhile, so this shows)
        if Play.cl-on: Rectangle {
            background: #000000aa;
            VerticalLayout {
                alignment: center;
                spacing: 10px;
                Text {
                    text: Play.cl-title;
                    font-size: 16px;
                    font-weight: 700 + T.fw;
                    color: #ffffff;
                    horizontal-alignment: center;
                }
                Text {
                    text: Play.cl-sub;
                    font-size: 14px;
                    color: #a1a1aa;
                    horizontal-alignment: center;
                }
            }
            Rectangle {
                y: parent.height - 6px;
                height: 6px;
                background: #ffffff1a;
                clip: true;
                Rectangle {
                    property <float> run;
                    x: Play.cl-pct < 0 ? (self.run * 1.3 - 0.3) * parent.width : 0;
                    width: Play.cl-pct < 0 ? parent.width * 0.3 : parent.width * min(1, Play.cl-pct);
                    animate width { duration: 100ms; easing: linear; } // 2x the 50 ms tick (cloud.rs fetch, smoothed bytes - dl_smooth.rs): one steady motion
                    background: T.accent;
                    // .ind: a 30 % piece sliding along while nothing is known
                    Timer {
                        interval: 30ms;
                        running: Play.cl-pct < 0;
                        triggered => { parent.run = Math.mod(parent.run + 0.027, 1.0); }
                    }
                }
            }
        }
        videota := TouchArea {
            // Chat A: wheel = zoom toward the mouse (up to 8x), drag = pan while zoomed; a drag is never a click
            property <bool> panned;
            property <length> px0;
            property <length> py0;
            mouse-cursor: Play.full && !Play.ui-on ? MouseCursor.none : Play.zoomed ? (self.pressed ? MouseCursor.grabbing : MouseCursor.grab) : MouseCursor.default;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    self.panned = false;
                    self.px0 = self.mouse-x;
                    self.py0 = self.mouse-y;
                    // QA B33 (11 Nov 2026): a click on the video takes the keys back from the Title / Tags / Note
                    // boxes (Space / P went into the title). Like any click away, it ends the title edit.
                    fs.focus();
                }
            }
            moved => {
                if (self.pressed && Play.zoomed && (self.panned || abs(self.mouse-x - self.px0) + abs(self.mouse-y - self.py0) > 4px)) {
                    self.panned = true;
                    Play.pan((self.mouse-x - self.px0) / max(1px, self.width), (self.mouse-y - self.py0) / max(1px, self.height));
                    self.px0 = self.mouse-x;
                    self.py0 = self.mouse-y;
                }
            }
            scroll-event(e) => {
                if (e.delta-y != 0 && !e.modifiers.control) {
                    // the amount, in notches: main.rs hands one wheel notch out as many small glide steps (160 px in
                    // all) - counting each step as a notch jumped to 8x at once
                    Play.zoom(e.delta-y / 160px, self.mouse-x / max(1px, self.width), self.mouse-y / max(1px, self.height));
                    return accept;
                }
                reject
            }
            clicked => {
                if (!self.panned) {
                    Play.toggle-pause();
                }
            }
            double-clicked => { Play.toggle-full(); }
        }
    }
    // 9 Nov: a slightly brighter outline hugging the clip itself (top, sides AND where it meets the strip).
    // Drawn 1 px OUTSIDE the picture: in window mode mpv's own window covers the picture, nothing Slint draws inside
    // it would show. The panel's fainter border around everything stays.
    if !Play.full: Rectangle {
        z: 5; // above the strip (drawn later), else it hides the bottom line
        x: root.vx - 1px;
        y: root.vy - 1px;
        width: root.vw + 2px;
        height: root.vh + 2px;
        border-width: 1px;
        border-color: #ffffff30; // toned down (asked: "a bit less on the actual player")
        border-radius: 12px;
    }
    if Play.has-prev && !Play.full && !inl: NavArrow {
        // QA E11: next to the video, not on the dimmed sidebar
        x: max(8px, root.vx - self.width - 14px);
        y: (root.height - self.height) / 2;
        icon: Ic.prev;
        tip: "Previous clip (Shift+←)";
        clicked => { Play.prev(); }
    }
    if Play.has-next && !Play.full && !inl: NavArrow {
        x: root.width - self.width - 18px;
        y: (root.height - self.height) / 2;
        icon: Ic.next;
        tip: "Next clip (Shift+→)";
        clicked => { Play.next(); }
    }

    // strip + controls (fullscreen: over the video, fading out when the mouse rests)
    chrome := Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        // mpv draws them (fullscreen, Windows window mode): invisible here, but still there for the mouse
        opacity: Play.mpv-osd ? 0 : root.show-ui ? 1 : 0;
        animate opacity { duration: 250ms; }
        visible: Play.mpv-osd ? root.show-ui : self.opacity > 0.01;
        // fullscreen: a soft fade above the strip; the controls area counts as "on the controls"
        if Play.full: Rectangle {
            x: root.vx;
            y: root.bar-y - 40px;
            width: root.vw;
            height: 40px;
            background: @linear-gradient(180deg, #00000000 0%, #000000aa 100%);
        }
        cta := TouchArea {
            x: root.vx;
            y: root.bar-y;
            width: root.vw;
            height: root.strip-h + root.ctl-h;
        }
        // 12 Nov 2026 (William: "a small split to gray here, why not fade it all the way"): ONE background for the strip
        // and the bar under it - the strip's colour at the top fading into the bar's deep theme shade at the bottom
        // (Light: light grey -> white -> a faint lavender); the strip and the bar draw no background of their own
        if !Play.full: Rectangle {
            x: root.vx;
            y: root.bar-y;
            width: root.vw;
            height: root.strip-h + root.ctl-h;
            border-bottom-left-radius: 11px;
            border-bottom-right-radius: 11px;
            background: T.text == #16161c
                ? @linear-gradient(180deg, #f4f4f7 0%, #ffffff 45%, T.accent.mix(#ffffff, 0.06) 100%)
                : @linear-gradient(180deg, #15151b 0%, #0e0e12 45%, T.accent.mix(#0d0d10, 0.14) 100%);
        }
        // ---- .pstrip: the filmstrip seek bar ----
        Rectangle {
            x: root.vx;
            y: root.bar-y;
            width: root.vw;
            height: root.strip-h;
            // (outside fullscreen: the one background above)
            background: Play.full ? #000000aa : transparent;
            Rectangle {
                height: 1px;
                y: 0;
                background: #ffffff14;
            }
            // gaps-cloud (row 6): Echo's #pup - the upload's bar, right under the video (mpv's window can't be drawn over)
            if Play.up-on: Rectangle {
                y: 0;
                height: 4px;
                background: #00000088;
                Rectangle {
                    x: 0;
                    width: parent.width * min(1, Play.up-pct);
                    animate width { duration: 400ms; }
                    background: #4cc2ff;
                }
            }
        }
        seek := Rectangle {
            x: root.vx + 18px;
            y: root.bar-y + 14px;
            width: root.vw - 36px;
            height: 46px;
            border-radius: 10px;
            background: T.text == #16161c && !Play.full ? #dcdce3 : #2a2a32; // Light: light grey behind the pictures
            clip: true;
            property <string> drag: "";   // "" / "seek" / "t0" / "t1"
            property <float> drag-frac: 0;
            property <float> hover: clamp(sa.mouse-x / max(1px, self.width), 0, 1);
            // glides between Rust's 250 ms updates (Rust sends the position it expects at the next update)
            property <float> glide: Play.progress;
            animate glide {
                duration: Play.snap ? 0ms : 250ms;
                easing: linear;
            }
            property <float> shown: drag == "seek" ? drag-frac : glide;
            property <int> n: max(1, round(self.width / (self.height * 16 / 9)));
            property <float> min-gap: Play.duration > 0 ? 0.5 / Play.duration : 0.02;
            // the frames
            if Play.sheet-ok: HorizontalLayout {
                spacing: 0;
                for i in seek.n: Image {
                    property <int> f: min(Play.tiles.length - 1, floor((i + 0.5) * Play.tiles.length / seek.n));
                    source: Play.tiles[f];
                    image-fit: cover;
                }
            }
            // dimmed so it reads as UI, brighter on hover
            Rectangle {
                background: sa.has-hover || seek.drag != "" ? #0000003b : #00000070;
                animate background { duration: T.fade; enabled: !T.rgb-live; }
            }
            // outside the trim selection
            Rectangle {
                x: 0;
                width: parent.width * Play.t0;
                background: #000000a0;
            }
            Rectangle {
                x: parent.width * Play.t1;
                width: parent.width * (1 - Play.t1);
                background: #000000a0;
            }
            // cut-out parts: nearly black, striped, skipped while playing
            for k in floor(Play.cuts.length / 2): Rectangle {
                x: parent.width * Play.cuts[k * 2];
                width: parent.width * (Play.cuts[k * 2 + 1] - Play.cuts[k * 2]);
                background: #000000d8;
                clip: true;
                for s in ceil(self.width / 10px) + 6: Path {
                    x: (s - 6) * 10px;
                    width: 60px;
                    height: parent.height;
                    viewbox-width: 60;
                    viewbox-height: 46;
                    commands: "M0 46 L46 0";
                    stroke: #ff5a5a40;
                    stroke-width: 1.5px;
                }
                Rectangle { x: 0; width: 1.5px; background: #ff5a5acc; }
                Rectangle { x: parent.width - 1.5px; width: 1.5px; background: #ff5a5acc; }
            }
            // the highlight (Shift+drag): X cuts it
            if Play.h0 >= 0: Rectangle {
                x: parent.width * min(Play.h0, Play.h1);
                width: max(2px, parent.width * abs(Play.h1 - Play.h0));
                background: T.hi.with-alpha(0.22);
                Rectangle { y: 0; height: 2px; background: T.hi; }
                Rectangle { y: parent.height - 2px; height: 2px; background: T.hi; }
            }
            // selection outline while trimming
            if Play.trimming: Rectangle {
                x: parent.width * Play.t0;
                width: parent.width * (Play.t1 - Play.t0);
                border-width: 2px;
                border-color: T.hi;
            }
            // 9 Nov: a light line along the top and bottom of the kept part, joining the two yellow ends
            // (the ends are the sides) - not while trimming, the yellow outline is there then
            if !Play.trimming: Rectangle {
                x: parent.width * Play.t0 + 12px;
                y: 0;
                width: max(0px, parent.width * (Play.t1 - Play.t0) - 24px);
                height: 2px;
                background: #ffffff8c;
            }
            if !Play.trimming: Rectangle {
                x: parent.width * Play.t0 + 12px;
                y: parent.height - 2px;
                width: max(0px, parent.width * (Play.t1 - Play.t0) - 24px);
                height: 2px;
                background: #ffffff8c;
            }
            // progress line at the bottom
            Rectangle {
                x: 0;
                y: parent.height - 4px;
                height: 4px;
                width: parent.width * seek.shown;
                background: T.accent;
            }
            // Chat A: bookmarks (Echo's yellow triangles at the top of the bar)
            for m in Play.marks: Path {
                x: parent.width * clamp(m / max(0.01, Play.duration), 0, 1) - 6px;
                y: 0;
                width: 12px;
                height: 8px;
                viewbox-width: 12;
                viewbox-height: 8;
                commands: "M0 0 L12 0 L6 8 Z";
                fill: #ffd84d;
                stroke: #00000088;
                stroke-width: 1px;
            }
            // play head
            Rectangle {
                x: parent.width * seek.shown - 1.5px;
                width: 3px;
                border-radius: 2px;
                background: white;
                drop-shadow-blur: 6px;
                drop-shadow-color: black;
            }
            // trim handles (always there - drag one to start trimming)
            Rectangle {
                x: parent.width * Play.t0;
                width: 12px;
                border-top-left-radius: 7px;
                border-bottom-left-radius: 7px;
                background: T.hi.with-alpha(0.8);
                Rectangle {
                    x: 5px;
                    width: 2px;
                    y: 14px;
                    height: parent.height - 28px;
                    border-radius: 1px;
                    background: #00000077;
                }
            }
            Rectangle {
                x: parent.width * Play.t1 - 12px;
                width: 12px;
                border-top-right-radius: 7px;
                border-bottom-right-radius: 7px;
                background: T.hi.with-alpha(0.8);
                Rectangle {
                    x: 5px;
                    width: 2px;
                    y: 14px;
                    height: parent.height - 28px;
                    border-radius: 1px;
                    background: #00000077;
                }
            }
            // outline
            Rectangle {
                border-radius: 10px;
                border-width: 1px;
                border-color: #ffffff2e;
            }
            sa := TouchArea {
                mouse-cursor: abs(self.mouse-x - parent.width * Play.t0 - 6px) < 12px || abs(self.mouse-x - parent.width * Play.t1 + 6px) < 12px ? MouseCursor.ew-resize : MouseCursor.pointer;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        let f = clamp(self.mouse-x / self.width, 0, 1);
                        if (e.modifiers.shift) {
                            // highlight a part (X cuts it, Esc clears)
                            seek.drag = "hl";
                            Play.h0 = f;
                            Play.h1 = f;
                        } else if (abs(self.mouse-x - parent.width * Play.t0 - 6px) < 14px) {
                            seek.drag = "t0";
                            Play.trimming = true;
                        } else if (abs(self.mouse-x - parent.width * Play.t1 + 6px) < 14px) {
                            seek.drag = "t1";
                            Play.trimming = true;
                        } else {
                            seek.drag = "seek";
                            seek.drag-frac = f;
                            Play.seek(f, true);
                        }
                    }
                    if (e.kind == PointerEventKind.up && seek.drag != "") {
                        if (seek.drag == "hl") {
                            if (abs(Play.h1 - Play.h0) < seek.min-gap) {
                                Play.h0 = -1;
                                Play.h1 = -1;
                            } else {
                                let lo = min(Play.h0, Play.h1);
                                Play.h1 = max(Play.h0, Play.h1);
                                Play.h0 = lo;
                            }
                        } else if (seek.drag == "seek") {
                            Play.seek(clamp(self.mouse-x / self.width, 0, 1), false);
                        } else {
                            Play.trim-changed(false);
                        }
                        seek.drag = "";
                    }
                }
                moved => {
                    let f = clamp(self.mouse-x / self.width, 0, 1);
                    if (seek.drag == "hl") {
                        Play.h1 = f;
                    }
                    if (seek.drag == "seek") {
                        seek.drag-frac = f;
                        Play.seek(f, true);
                    }
                    if (seek.drag == "t0") {
                        Play.t0 = clamp(f, 0, Play.t1 - seek.min-gap);
                        Play.trim-changed(true);
                    }
                    if (seek.drag == "t1") {
                        Play.t1 = clamp(f, Play.t0 + seek.min-gap, 1);
                        Play.trim-changed(true);
                    }
                }
            }
            // L35: Echo's title on the strip
            TipArea {
                text: "Click to jump · drag the yellow ends to trim";
                hover: sa.has-hover && !sa.pressed && seek.drag == "";
            }
            // a small x in the middle of each cut: click = put it back
            for k in floor(Play.cuts.length / 2): Rectangle {
                property <length> cx: parent.width * (Play.cuts[k * 2] + Play.cuts[k * 2 + 1]) / 2;
                visible: parent.width * (Play.cuts[k * 2 + 1] - Play.cuts[k * 2]) > 24px;
                x: self.cx - 10px;
                y: (parent.height - 20px) / 2;
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: ub.has-hover ? #ff5a5a : #000000b0;
                border-width: 1px;
                border-color: #ff5a5acc;
                Path {
                    width: 8px;
                    height: 8px;
                    viewbox-width: 8;
                    viewbox-height: 8;
                    commands: "M0 0 L8 8 M8 0 L0 8";
                    stroke: white;
                    stroke-width: 1.5px;
                }
                ub := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Play.uncut(k); }
                }
            }
        }
        // hover / drag preview above the strip (#ptip)
        if root.preview-on && !Play.mpv-osd: Rectangle {
            x: root.preview-x;
            y: root.preview-y;
            width: root.pw;
            height: root.ph;
            border-radius: 9px;
            border-width: 2px;
            border-color: #ffffffd9;
            background: black;
            clip: true;
            // pv-in: no shadow (it would fall on the strip below the video and lag behind mpv's copy)
            drop-shadow-blur: root.pv-in ? 0px : 24px;
            drop-shadow-offset-y: root.pv-in ? 0px : 8px;
            drop-shadow-color: root.pv-in ? transparent : #000000cc;
            property <float> f: seek.drag == "seek" ? seek.drag-frac : seek.drag == "t0" ? Play.t0 : seek.drag == "t1" ? Play.t1 : seek.hover;
            property <int> n: min(Play.tiles.length - 1, floor(f * Play.tiles.length));
            Image {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                source: Play.tiles[n];
                image-fit: fill;
            }
            Text {
                y: parent.height - 24px;
                text: Fmt.t0(f * Play.duration);
                font-size: 12.5px;
                font-weight: 600 + T.fw;
                color: white;
                horizontal-alignment: center;
                width: parent.width;
            }
        }

        // ---- .ctl ----
        Rectangle {
            x: root.vx;
            y: root.bar-y + root.strip-h;
            width: root.vw;
            height: root.ctl-h;
            // (outside fullscreen: the one background above the strip - no second colour, no seam)
            background: Play.full ? #000000aa : transparent;
            border-bottom-left-radius: Play.full ? 0 : 11px;
            border-bottom-right-radius: Play.full ? 0 : 11px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 4px;
                BarPlay { }
                Rectangle { width: 6px; }
                // current time bold, total muted
                HorizontalLayout {
                    spacing: 0px;
                    // the editor's mono font
                    Text {
                        text: Play.time-text;
                        font-family: "Cascadia Mono";
                        font-size: 14px;
                        font-weight: 600 + T.fw;
                        color: Play.full ? #ffffff : T.text;
                        vertical-alignment: center;
                    }
                    Text {
                        text: " / " + Play.dur-text;
                        font-family: "Cascadia Mono";
                        font-size: 14px;
                        color: Play.full ? #bbbbbb : T.muted;
                        vertical-alignment: center;
                    }
                }
                Text {
                    // prototype stats (where Echo has nothing): codec, decoder, frames
                    // gaps-cloud (row 6): Echo's #puplbl "☁ Uploading 40% · 1 min left" while this clip uploads
                    text: Play.trimming ? "" : Play.up-on ? Play.up-text : !Play.show-stats ? "" : Play.stats;
                    font-size: Play.up-on ? 12px : 11.5px;
                    font-weight: Play.up-on ? 600 + T.fw : 400 + T.fw;
                    color: Play.up-on ? #4cc2ff : T.dim;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                // .tctl - shown while trimming
                if Play.trimming && !Play.mpv-osd: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: Fmt.t1(Play.t0 * Play.duration) + " – " + Fmt.t1(Play.t1 * Play.duration);
                        font-size: 12.5px;
                        font-weight: 600 + T.fw;
                        color: T.text;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "· " + round(max(0, Play.t1 - Play.t0 - Play.cut-sum) * Play.duration * 10) / 10 + "s";
                        font-size: 12.5px;
                        color: T.muted;
                        vertical-alignment: center;
                    }
                    Rectangle { width: 4px; }
                    Check {
                        text: "Exact";
                        tip: "Frame-exact start (re-encodes, a bit slower)"; // L16: was a TipArea cell with no hover
                        checked <=> Play.exact;
                    }
                    Btn {
                        y: 3px;
                        small: true;
                        text: "Cancel";
                        tip: "Cancel (T)";
                        clicked => { Play.trim-cancel(); }
                    }
                    Btn {
                        y: 3px;
                        small: true;
                        text: "GIF";
                        tip: "Make a GIF of the selection and copy it (max 30 s)";
                        enabled: !Play.gif-busy; // L14/L15: Echo's #tgif.disabled while it works
                        clicked => { Play.act("gif"); }
                    }
                    Btn {
                        y: 3px;
                        small: true;
                        text: "Replace";
                        enabled: !Play.busy; // L14/L15: Echo disables Save copy + Replace while either runs
                        clicked => { Play.act("replace"); }
                    }
                    Btn {
                        y: 3px;
                        small: true;
                        primary: true;
                        enabled: !Play.busy;
                        text: Play.busy ? "Saving…" : "Save copy";
                        clicked => {
                            if (!Play.busy) {
                                Play.trim-save();
                            }
                        }
                    }
                }
                if !Play.trimming: SpeedTxt { }
                Rectangle { width: 10px; }
                // "VOL" (click = mute), then 10 slanted ticks: one click = mute / unmute, click + drag =
                // set the volume (fine, not whole ticks: the last lit tick fills partly). Muted: the level stays faint.
                VolLbl { }
                vol := Rectangle {
                    width: 10 * 7px + 1px;
                    property <color> fg: Play.full ? #ffffff : T.text;
                    property <bool> hot: vta.has-hover || vta.pressed;
                    property <length> start-x;
                    property <bool> dragging;
                    for i in 10: Path {
                        x: i * 7px;
                        y: (parent.height - 12px) / 2;
                        width: 7.9px;
                        height: 12px;
                        viewbox-width: 7.9;
                        viewbox-height: 12;
                        commands: "M3.9 0H7.9L4 12H0Z";
                        fill: vol.fg.with-alpha(0.18);
                        stroke-width: 0px;
                    }
                    // the lit part: the same ticks, cut at the volume
                    Rectangle {
                        x: 0;
                        width: vol.width * Play.volume;
                        clip: true;
                        for i in 10: Path {
                            x: i * 7px;
                            y: (parent.height - 12px) / 2;
                            width: 7.9px;
                            height: 12px;
                            viewbox-width: 7.9;
                            viewbox-height: 12;
                            commands: "M3.9 0H7.9L4 12H0Z";
                            fill: Play.muted ? vol.fg.with-alpha(0.32) : vol.fg.with-alpha(vol.hot ? 1 : 0.92);
                            stroke-width: 0px;
                        }
                    }
                    vta := TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                vol.start-x = self.mouse-x;
                                vol.dragging = false;
                            } else if (e.kind == PointerEventKind.up && !vol.dragging) {
                                Play.toggle-mute();
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                if (!vol.dragging && abs(self.mouse-x - vol.start-x) > 3px) {
                                    vol.dragging = true;
                                }
                                if (vol.dragging) {
                                    Play.volume = clamp(self.mouse-x / self.width, 0, 1);
                                    Play.muted = false;
                                    Play.set-volume(Play.volume, false);
                                }
                            }
                        }
                    }
                    TipArea {
                        text: vol.dragging ? round(Play.volume * 100) + " %" : Play.muted ? "Click: unmute · drag: volume" : "Click: mute · drag: volume";
                        hover: vta.has-hover;
                    }
                }
                Rectangle { width: 8px; }
                Cb {
                    icon: Play.full ? Ic2.unfs : Ic2.fs;
                    tip: Play.full ? "Exit fullscreen (F)" : "Fullscreen (F)";
                    clicked => { Play.toggle-full(); }
                }
            }
        }
    }

    // ---- .phint ----
    // the key hints stay hidden until the mouse is over their spot under the player
    if !Play.full && !inl: Rectangle {
        x: root.vx;
        y: root.vy + root.vh + root.strip-h + root.ctl-h + 4px;
        width: root.vw;
        height: 44px;
        hint-ta := TouchArea { }
    Rectangle {
        opacity: hint-ta.has-hover ? 1 : 0;
        animate opacity { duration: 160ms; }
    HorizontalLayout {
        width: self.preferred-width;
        x: (parent.width - self.preferred-width) / 2;
        y: 12px;
        height: 20px;
        spacing: 4px;
        Kbd { text: "←"; }
        Kbd { text: "→"; }
        Text {
            text: " skip 5 s (";
            font-size: 12px;
            color: T.dim;
            vertical-alignment: center;
        }
        Kbd { text: "Ctrl"; }
        Text {
            text: " 2.5 s) · ";
            font-size: 12px;
            color: T.dim;
            vertical-alignment: center;
        }
        Kbd { text: "J"; }
        Kbd { text: "L"; }
        Text {
            text: " 10 s · ";
            font-size: 12px;
            color: T.dim;
            vertical-alignment: center;
        }
        Kbd { text: "M"; }
        Text {
            text: " mute · ";
            font-size: 12px;
            color: T.dim;
            vertical-alignment: center;
        }
        Kbd { text: "Shift"; }
        Text {
            text: "+";
            font-size: 12px;
            color: T.dim;
            vertical-alignment: center;
        }
        Kbd { text: "←"; }
        Kbd { text: "→"; }
        Text {
            text: " previous / next clip · drag the yellow ends of the strip to trim · ";
            font-size: 12px;
            color: T.dim;
            vertical-alignment: center;
        }
        Kbd { text: "Esc"; }
        Text {
            text: " close";
            font-size: 12px;
            color: T.dim;
            vertical-alignment: center;
        }
    }
    }
    }

    // ---- side panel (#pside), 11 Nov 2026: a compact card with every action of the old top row ----
    // (a solid card: Home no longer shows through). Narrow windows have no side panel: the old top row stays there.
    if root.side-on && !Play.full && !inl: card := Rectangle {
        x: root.side-x;
        y: clamp((root.height - sv.preferred-height) / 2, root.vy, max(root.vy, root.height - sv.preferred-height - 12px));
        width: root.side-w;
        height: sv.preferred-height;
        background: T.panel;
        border-radius: 12px;
        border-width: 1px;
        border-color: #ffffff1f;
        drop-shadow-blur: 36px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000073;
        property <bool> tag-open;
        property <bool> note-open;
        // clicks inside the card never count as "beside the video"
        TouchArea { }
        // Esc while typing a tag / note still closes the player (the text fields keep every other key)
        FocusScope {
            focus-on-click: false;
            capture-key-pressed(e) => {
                // L33: not in the title box - there Esc puts the old name back and the player stays open
                if (e.text == Key.Escape && !tt.has-focus) {
                    Play.close();
                    return accept;
                }
                reject
            }
            sv := VerticalLayout {
                padding: 14px;
                spacing: 10px;
                // Echo's #sname: edit the name here - Enter or clicking away renames the clip (the player keeps
                // playing from the same spot), Esc puts the old name back
                Rectangle {
                    background: T.panel2;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: tt.has-focus ? T.accent : T.line;
                    height: tt.preferred-height + 18px;
                    TouchArea {
                        mouse-cursor: MouseCursor.text;
                        clicked => { tt.focus(); }
                    }
                    tt := TextInput {
                        x: 11px;
                        y: 9px;
                        width: parent.width - 22px;
                        text: Play.title;
                        read-only: Play.cloud-only; // gaps-cloud (row 4): Echo's #sname.readOnly for cloud clips
                        single-line: false;
                        wrap: word-wrap;
                        font-size: 13.5px;
                        font-weight: 600 + T.fw;
                        color: T.text;
                        selection-background-color: T.accent.with-alpha(0.45);
                        property <bool> cancel;
                        // typing breaks the `text: Play.title` binding: put the name back for every new clip
                        property <string> src: Play.title;
                        changed src => {
                            self.text = Play.title;
                        }
                        key-pressed(e) => {
                            if (e.text == Key.Return) {
                                self.clear-focus();
                                Focus.back(); // L2: the player's keys (Space, arrows) work again at once
                                return accept;
                            }
                            if (e.text == Key.Escape) {
                                self.cancel = true;
                                self.text = Play.title;
                                self.clear-focus();
                                Focus.back();
                                return accept;
                            }
                            reject
                        }
                        changed has-focus => {
                            if (!self.has-focus) {
                                if (!self.cancel && self.text != Play.title) {
                                    Play.act("rename:" + self.text);
                                }
                                self.cancel = false;
                            }
                        }
                    }
                }
                // tags: the chips, then "+ Tag" (opens the tag box; it closes again when left empty)
                VerticalLayout {
                    spacing: 6px;
                    FlexboxLayout {
                        spacing: 6px;
                        for t in Play.tags: TagChip {
                            text: t;
                            remove => { Play.remove-tag(self.text); }
                        }
                        if !card.tag-open: AddChip {
                            text: "Tag";
                            clicked => {
                                card.tag-open = true;
                                tagin.open-box();
                            }
                        }
                    }
                    tagin := DinField {
                        visible: card.tag-open;
                        height: card.tag-open ? 36px : 0px;
                        placeholder: "Add a tag + Enter";
                        accepted(t) => {
                            Play.add-tag(t);
                            self.text = "";
                            Play.tag-hints = [];
                        }
                        edited(t) => { Play.tag-typed(t); }
                        focus-out(t) => {
                            if (t != "") {
                                Play.tag-blur(t);
                                self.text = "";
                            }
                            Play.tag-hints = [];
                            card.tag-open = false;
                        }
                    }
                    // existing tags that match (a click adds it; focus stays in the box)
                    if card.tag-open && Play.tag-hints.length > 0 && tagin.text != "": Rectangle {
                        height: hl.preferred-height;
                        background: T.panel2;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: T.line;
                        hl := VerticalLayout {
                            padding: 4px;
                            for h in Play.tag-hints: Rectangle {
                                height: 26px;
                                border-radius: 6px;
                                background: hta.has-hover ? T.panel : transparent;
                                hta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        Play.add-tag(h);
                                        tagin.text = "";
                                        Play.tag-hints = [];
                                    }
                                }
                                Text {
                                    x: 8px;
                                    text: "#" + h;
                                    font-size: 12.5px;
                                    color: T.accent2;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                // note: "+ Add a note" until there is one (or you click it)
                if Play.note == "" && !card.note-open: AddRow {
                    text: "Add a note";
                    clicked => {
                        card.note-open = true;
                        notein.open-box();
                    }
                }
                notein := DinField {
                    visible: Play.note != "" || card.note-open;
                    height: self.visible ? 110px : 0px;
                    multi: true;
                    text <=> Play.note;
                    placeholder: "Anything to remember…";
                    edited(t) => { Play.note-edited(t); }
                    focus-out(t) => {
                        if (Play.note == "") {
                            card.note-open = false;
                        }
                    }
                }
                Rectangle { height: 1px; background: T.line; }
                // the details as chips: length, size, 1080p60, codec, date (Rust: Play.info-chips)
                FlexboxLayout {
                    spacing: 5px;
                    InfoChip { text: Play.dur-text; }
                    for s in Play.info-chips: InfoChip { text: s; }
                }
                Rectangle { height: 1px; background: T.line; }
                // Copy (split: the arrow = the size menu) + Share
                acts := HorizontalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 1px;
                        horizontal-stretch: 1;
                        PanelBtn {
                            text: "Copy";
                            icon: Ic.copy;
                            primary: true;
                            part: "left";
                            horizontal-stretch: 1;
                            tip: "Copy (Ctrl+click: choose size)";
                            clicked => {
                                if (self.ctrl) {
                                    cm2.show();
                                } else {
                                    Play.act("copy");
                                }
                            }
                        }
                        PanelBtn {
                            icon: Ic.down;
                            primary: true;
                            part: "right";
                            width: 26px;
                            tip: "Copy smaller for Discord";
                            clicked => { cm2.show(); }
                        }
                    }
                    PanelBtn {
                        text: "Share";
                        icon: Ic.share;
                        horizontal-stretch: 1;
                        tip: "Upload and copy a link that plays in Discord";
                        clicked => {
                            Cm.open = false;
                            Play.act("share");
                            if (Cm.open) {
                                Cm.open = false;
                                sharepop2.show();
                            }
                        }
                    }
                }
                // the rest: Trim, Edit, Frame, Sound / Thumb, Cloud, Folder, Delete
                tiles := GridLayout {
                    spacing: 5px;
                    Row {
                        ActTile {
                            icon: Ic.trim;
                            text: "Trim";
                            tip: "Trim (T)";
                            active: Play.trimming;
                            clicked => {
                                if (Play.trimming) {
                                    Play.trim-cancel();
                                } else {
                                    Play.trimming = true;
                                    Play.trim-changed(false);
                                }
                            }
                        }
                        ActTile {
                            icon: Ic.edit;
                            text: "Edit";
                            tip: "Open in editor (E)";
                            clicked => { Play.act("edit"); }
                        }
                        ActTile {
                            icon: Ic.frame;
                            text: "Frame";
                            tip: "Save this frame as a picture + copy it (P)";
                            clicked => { Play.act("frame"); }
                        }
                        ActTile {
                            icon: Ic.music;
                            text: "Sound";
                            tip: "Save the sound as MP3 or WAV + copy it";
                            clicked => { mp3pop2.show(); }
                        }
                    }
                    Row {
                        ActTile {
                            icon: Ic.image;
                            text: "Thumb";
                            tip: "Use this frame as the clip's thumbnail";
                            clicked => { Play.act("thumb"); }
                        }
                        ActTile {
                            icon: Ic.cloud;
                            text: "Cloud";
                            tip: "Cloud: upload, free up space, download, delete";
                            clicked => {
                                Cm.open = false;
                                Play.act("cloud");
                                if (Cm.open) {
                                    Cm.open = false;
                                    cloudpop2.show();
                                }
                            }
                        }
                        ActTile {
                            icon: Ic.folder;
                            text: "Folder";
                            tip: "Show in folder";
                            clicked => { Play.act("folder"); }
                        }
                        ActTile {
                            icon: Ic.del;
                            text: "Delete";
                            tip: "Delete (Del)";
                            red: true;
                            clicked => { Play.act("delete"); }
                        }
                    }
                }
            }
        }
        // the menus open to the LEFT of the card (over the video, which Rust parks while a popup is open), level
        // with the button that opened them
        property <length> acts-y: acts.absolute-position.y - self.absolute-position.y;
        property <length> tiles-y: tiles.absolute-position.y - self.absolute-position.y;
        cm2 := PopupWindow {
            x: - self.width - 8px;
            y: card.acts-y;
            width: cmb2.preferred-width;
            height: cmb2.preferred-height;
            close-policy: close-on-click-outside;
            cmb2 := CopyMenuBody {
                size-text: Play.size-text;
                picked(k) => {
                    cm2.close();
                    Play.act("copy:" + k);
                    fs.focus();
                }
                cancel => {
                    cm2.close();
                    fs.focus();
                }
            }
        }
        sharepop2 := PopupWindow {
            x: - self.width - 8px;
            y: card.acts-y;
            width: sharepopb2.preferred-width;
            height: sharepopb2.preferred-height;
            close-policy: close-on-click-outside;
            sharepopb2 := CloudMenuBody {
                done => { sharepop2.close(); }
            }
        }
        cloudpop2 := PopupWindow {
            x: - self.width - 8px;
            y: card.tiles-y;
            width: cloudpopb2.preferred-width;
            height: cloudpopb2.preferred-height;
            close-policy: close-on-click-outside;
            cloudpopb2 := CloudMenuBody {
                done => { cloudpop2.close(); }
            }
        }
        mp3pop2 := PopupWindow {
            x: - self.width - 8px;
            y: card.tiles-y;
            width: 230px;
            height: mp3l2.preferred-height;
            close-policy: close-on-click-outside;
            Rectangle {
                background: T.panel;
                border-radius: 12px;
                border-width: 1px;
                border-color: T.line;
                drop-shadow-blur: 40px;
                drop-shadow-offset-y: 14px;
                drop-shadow-color: #000000aa;
                TouchArea { }
            }
            mp3l2 := VerticalLayout {
                padding: 6px;
                MenuRow {
                    text: "Save as MP3";
                    clicked => {
                        mp3pop2.close();
                        Play.act("audio");
                        fs.focus();
                    }
                }
                MenuRow {
                    text: "Save as WAV (sound effects)";
                    clicked => {
                        mp3pop2.close();
                        Play.act("wav");
                        fs.focus();
                    }
                }
            }
        }
    }
}
