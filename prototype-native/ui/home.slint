// Echo's Home (#page-home, chat 30 "mockup v6"): the latest clip big + what to do with it, one "Get started" line,
// quiet numbers (.hstrip), one row of recent clips. Rust fills HomeState; Home's cards are normal library cards
// (Card.idx = HOME_BASE + position, so hover / favourite / buttons work through Lib like everywhere else).
import { T, Ic, Icon, TipArea, Btn, CopyMenuBody } from "theme.slint";
import { Card, CardView, Lib } from "library.slint";

export global HomeState {
    in-out property <[Card]> cards;        // [0] = the latest clip (big), then the recent ones
    in-out property <image> hero;          // a sharp still of the latest clip (ffmpeg), else its card picture
    in-out property <string> hero-meta;    // "1 hour ago · 58.8 MB · FiveM"
    in-out property <int> extra;           // px for tag / note lines under the recent cards
    // .hstrip
    in-out property <string> week;
    in-out property <string> total;
    in-out property <string> size;
    in-out property <string> games;
    in-out property <string> games-word;   // "game" / "games"
    in-out property <[int]> bars;          // clips per week, last 6 weeks (oldest first)
    in-out property <int> bars-max: 1;
    in-out property <bool> spark;          // at least 3 weeks with clips
    in-out property <[int]> days;          // William (10 Nov): clips per day, last 7 days (today last)
    in-out property <[string]> day-l;      // their day letters ("M", "T", …)
    in-out property <int> days-max: 1;
    // Get started (.hgs)
    in-out property <bool> gs-on;
    in-out property <[bool]> gs-done;
    in-out property <string> gs-title;     // "trim or edit a clip"
    in-out property <string> gs-text;      // "cut it down to the good part"
    in-out property <string> gs-go;        // button ("" = none)
    in-out property <string> empty-key;    // first hotkey, for "No clips yet"
    callback act(string);                  // "copy" / "copym" / "edit" / "link" / "cap" / "play" / "library" / "gs-go" / "gs-skip" / "gs-hide"
    callback cols(int);                    // recent cards that fit in one row (2..7)
}

// .hacts .hb: padding 10 14, radius 10, line border, panel
component HB inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    callback clicked;
    height: 42px;
    border-radius: 10px;
    border-width: 1px;
    border-color: ta.has-hover ? T.muted : T.line;
    background: T.panel;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    // William (10 Nov): three of these side by side under Copy for Discord - icon + label centred
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            width: 15px;
            height: 15px;
            commands: root.icon;
            stroke: T.muted;
        }
        Text {
            text: root.text;
            font-size: 13.5px;
            color: T.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// William (10 Nov): one of Home's four number boxes (was a bare strip between two lines)
component StatBox inherits Rectangle {
    in property <string> n;
    in property <string> l;
    height: 76px;
    border-radius: 14px;
    border-width: 1px;
    border-color: T.line;
    background: T.panel;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.n;
                font-size: 20px;
                font-weight: 700 + T.fw;
                color: T.text;
            }
            Text {
                text: root.l;
                font-size: 12px;
                color: T.dim;
                overflow: elide;
            }
        }
        @children
    }
}

export component HomePage inherits Rectangle {
    background: transparent;
    // page padding 0 28 36; .hhero columns: min(62%, 48vh * 16/9) + minmax(280, 540), gap 24
    in property <length> win-h;
    property <length> cw: self.width - 56px - 8px;
    property <length> shot-w: max(200px, min(cw * 0.62, win-h * 0.48 * 16 / 9, cw - 24px - 280px));
    property <length> side-w: min(540px, cw - shot-w - 24px);
    property <length> shot-h: shot-w * 9 / 16;
    // one row of recent clips, as many as fit (2 to 7): ~250 px cards
    property <int> rcols: max(2, min(7, floor((cw + 14px) / 264px)));
    changed rcols => { HomeState.cols(self.rcols); }
    init => {
        HomeState.cols(self.rcols);
        self.sync-hero();
    }
    property <length> rcard-w: (cw - (rcols - 1) * 14px) / rcols;
    property <length> rcard-h: rcard-w * 9 / 16 + 2px + 68px + HomeState.extra * 1px;
    property <bool> has: HomeState.cards.length > 0;
    // gaps (10 Nov): the hero card = the latest clip's card with the sharp still as its picture
    property <Card> c0: HomeState.cards[0];
    property <image> hero-img: HomeState.hero;
    property <Card> hero-card;
    function sync-hero() {
        self.hero-card = self.c0;
        self.hero-card.thumb = self.hero-img;
        self.hero-card.has-thumb = true;
    }
    changed c0 => { self.sync-hero(); }
    changed hero-img => { self.sync-hero(); }

    Flickable {
        width: parent.width;
        height: parent.height;
        content-height: body.preferred-height;
        body := VerticalLayout {
            height: self.preferred-height;
            padding-left: 28px;
            padding-right: 36px;
            padding-bottom: 36px;
            // 24 (was 4): "Your latest clip" sat right under the top bar (William, 10 Nov 2026)
            padding-top: 24px;
            spacing: 0;
            // .hempty
            if !root.has: Text {
                height: 120px;
                text: "No clips yet. Play a game and press " + HomeState.empty-key + " - your clip shows up here.";
                font-size: 14px;
                color: T.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            // .hhero
            if root.has: HorizontalLayout {
                spacing: 24px;
                alignment: start;
                height: max(root.shot-h, side.preferred-height);
                // .hshot: the latest clip big, radius 14; hover = play circle; click plays
                // gaps (10 Nov): Echo's hero is a full card (makeCard: badges, job progress, game icon) with its name
                // part hidden - the card's picture fills the hero
                shot := Rectangle {
                    width: root.shot-w;
                    height: root.shot-h;
                    y: 0;
                    border-radius: 14px;
                    background: #0a0a0c;
                    clip: true;
                    property <bool> hov: Lib.hover-idx == HomeState.cards[0].idx;
                    CardView {
                        x: -1px;
                        // the card lifts 3 px on hover: move it down as much, so the hero itself stays still
                        y: parent.hov ? 2px : -1px;
                        animate y { duration: T.lift; easing: ease-out; }
                        width: parent.width + 2px;
                        // only the picture: the card's name part is cut off by its own clip (no hidden mouse area
                        // below the hero)
                        height: parent.height + 2px;
                        data: root.hero-card;
                    }
                    Rectangle {
                        width: 64px;
                        height: 64px;
                        border-radius: 32px;
                        background: #ffffff2e;
                        opacity: parent.hov ? 1 : 0;
                        animate opacity { duration: 180ms; }
                        Path {
                            width: 26px;
                            height: 26px;
                            x: 21px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            fill: white;
                            commands: "M8 5l12 7-12 7z";
                        }
                    }
                }
                // .hside
                side := VerticalLayout {
                    width: root.side-w;
                    alignment: start;
                    spacing: 0;
                    Text {
                        text: "YOUR LATEST CLIP";
                        font-size: 11px;
                        font-weight: 600 + T.fw;
                        letter-spacing: 0.88px;
                        color: T.dim;
                    }
                    Rectangle { height: 6px; }
                    Text {
                        text: HomeState.cards[0].title;
                        font-family: "Segoe UI Variable Display";
                        font-size: 22px;
                        font-weight: 700 + T.fw;
                        color: T.text;
                        wrap: word-wrap;
                        overflow: elide;
                        max-height: 54px;   // 2 lines (line-clamp 2)
                    }
                    Rectangle { height: 4px; }
                    Text {
                        text: HomeState.hero-meta;
                        font-size: 13px;
                        color: T.muted;
                    }
                    Rectangle { height: 18px; }
                    // .hacts: grid gap 8
                    VerticalLayout {
                        spacing: 8px;
                        // .hsplit: accent "Copy for Discord" + ▾ (size menu)
                        HorizontalLayout {
                            height: 42px;
                            Rectangle {
                                horizontal-stretch: 1;
                                border-top-left-radius: 10px;
                                border-bottom-left-radius: 10px;
                                background: cta.has-hover ? T.accent.brighter(0.12) : T.accent;
                                cta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { HomeState.act("copy"); }
                                }
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 10px;
                                    Text {
                                        text: "Copy for Discord";
                                        font-size: 14px;
                                        color: white;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                            Rectangle {
                                width: 40px;
                                border-top-right-radius: 10px;
                                border-bottom-right-radius: 10px;
                                background: ata.has-hover ? T.accent.brighter(0.12) : T.accent;
                                Rectangle {
                                    x: 0;
                                    width: 1px;
                                    background: #ffffff40;
                                }
                                // gaps (10 Nov): Echo's copyMenu - the sizes (theme.slint CopyMenuBody, like the cards)
                                ata := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { cm.show(); }
                                }
                                cm := PopupWindow {
                                    x: parent.width - self.width;
                                    y: parent.height + 6px;
                                    // own size: Slint tests clicks against it (see library.slint's copy menu)
                                    width: cmb.preferred-width;
                                    height: cmb.preferred-height;
                                    close-policy: close-on-click-outside;
                                    cmb := CopyMenuBody {
                                        size-text: HomeState.cards[0].size;
                                        picked(k) => {
                                            cm.close();
                                            HomeState.act("copy:" + k);
                                        }
                                    }
                                }
                                TipArea {
                                    text: "Choose the size";
                                    hover: ata.has-hover;
                                }
                                Icon {
                                    width: 13px;
                                    height: 13px;
                                    stroke-width: 2.4px;
                                    commands: Ic.down;
                                    stroke: white;
                                }
                            }
                        }
                        // William (10 Nov): the three actions side by side, equal width (were three stacked rows)
                        HorizontalLayout {
                            spacing: 8px;
                            HB {
                                horizontal-stretch: 1;
                                text: "Trim / edit";
                                icon: Ic.trim;
                                clicked => { HomeState.act("edit"); }
                            }
                            HB {
                                horizontal-stretch: 1;
                                text: "Share link";
                                icon: Ic.link;
                                clicked => { HomeState.act("link"); }
                            }
                            HB {
                                horizontal-stretch: 1;
                                text: "Captions";
                                icon: Ic.cc;
                                clicked => { HomeState.act("cap"); }
                            }
                        }
                    }
                }
            }
            // .hgs: one "Get started" line (margin-top 18)
            // gaps (10 Nov): with no clips yet Echo still shows Get started, the numbers and the Recent row
            if HomeState.gs-on: VerticalLayout {
                padding-top: 18px;
                Rectangle {
                    height: 46px;
                    border-radius: 12px;
                    background: T.accent.with-alpha(0.07);
                    border-width: 1px;
                    border-color: T.accent.with-alpha(0.22);
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 14px;
                        HorizontalLayout {
                            spacing: 6px;
                            for d in HomeState.gs-done: Rectangle {
                                y: (parent.height - 5px) / 2;
                                width: 22px;
                                height: 5px;
                                border-radius: 3px;
                                background: d ? T.accent : T.line;
                            }
                        }
                        Text {
                            text: "Next step:";
                            font-size: 14px;
                            font-weight: 700 + T.fw;
                            color: T.text;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            Text {
                                text: HomeState.gs-title;
                                font-size: 13px;
                                color: T.muted;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "· " + HomeState.gs-text;
                                font-size: 13px;
                                color: T.dim;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                        if HomeState.gs-go != "": Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 28px;
                            width: gt.preferred-width + 24px;
                            border-radius: 8px;
                            background: gta.has-hover ? T.accent.brighter(0.12) : T.accent;
                            gt := Text {
                                text: HomeState.gs-go;
                                font-size: 12px;
                                color: white;
                            }
                            gta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { HomeState.act("gs-go"); }
                            }
                        }
                        Text {
                            text: "Skip";
                            font-size: 12px;
                            color: ska.has-hover ? T.text : T.dim;
                            vertical-alignment: center;
                            ska := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { HomeState.act("gs-skip"); }
                            }
                        }
                        Text {
                            text: "Hide";
                            font-size: 12px;
                            color: hda.has-hover ? T.text : T.dim;
                            vertical-alignment: center;
                            hda := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { HomeState.act("gs-hide"); }
                            }
                        }
                    }
                }
            }
            // .hstrip: margin 22 0 6, padding 14 0, lines above + below, gap 28
            // William (10 Nov): four equal boxes; the first holds clips per day for the last 7 days (today last,
            // brighter), with the day letters under it - same colours as the old 6-week spark
            HorizontalLayout {
                padding-top: 22px;
                padding-bottom: 6px;
                spacing: 12px;
                StatBox {
                    horizontal-stretch: 1;
                    n: HomeState.week;
                    l: "clips this week";
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: end;
                        for d[i] in HomeState.days: VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            Rectangle {
                                width: 8px;
                                height: 28px;
                                Rectangle {
                                    y: parent.height - self.height;
                                    height: d == 0 ? 2px : max(3px, 28px * d / HomeState.days-max);
                                    border-radius: 3px;
                                    background: d == 0 ? T.line : T.accent;
                                    opacity: d == 0 || i == HomeState.days.length - 1 ? 1 : 0.5;
                                }
                            }
                            Text {
                                text: HomeState.day-l[i];
                                font-size: 9.5px;
                                color: T.dim;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
                StatBox {
                    horizontal-stretch: 1;
                    n: HomeState.total;
                    l: "clips in total";
                }
                StatBox {
                    horizontal-stretch: 1;
                    n: HomeState.size;
                    l: "on this PC";
                }
                StatBox {
                    horizontal-stretch: 1;
                    n: HomeState.games;
                    l: HomeState.games-word;
                }
            }
            // .hrow: "Recent" + "Open library →" (margin 26 0 12)
            HorizontalLayout {
                padding-top: 26px;
                padding-bottom: 12px;
                Text {
                    text: "Recent";
                    font-family: "Segoe UI Variable Display";
                    font-size: 15px;
                    font-weight: 700 + T.fw;
                    color: T.text;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "Open library →";
                    font-size: 12px;
                    color: ola.has-hover ? T.accent2 : T.accent;
                    vertical-alignment: bottom;
                    ola := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { HomeState.act("library"); }
                    }
                }
            }
            // #hrecent: one row, gap 14
            if root.has && HomeState.cards.length > 1: HorizontalLayout {
                height: root.rcard-h + 4px;
                spacing: 0;
                alignment: start;
                padding-top: 4px;   // room for the hover lift
                for c[i] in HomeState.cards: Rectangle {
                    // [0] is the big one above; gap 14 in front of every card but the first
                    width: i == 0 ? 0px : i == 1 ? root.rcard-w : root.rcard-w + 14px;
                    visible: i > 0;
                    if i > 0: CardView {
                        x: i == 1 ? 0px : 14px;
                        tag-wrap: false; // r2-layout (L9): one line of tags here (HomeState.extra)
                        width: root.rcard-w;
                        height: root.rcard-h;
                        data: c;
                    }
                }
            }
        }
    }
}
