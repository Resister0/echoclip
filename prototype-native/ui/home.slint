// Echo's Home, 11 Nov 2026 "Inbox" (the user's pick from the Home mockups): ONE clip big - the newest one not looked at
// yet - with a side panel as tall as the picture (pager, buttons with keys, the clip's details), then "Your games".
// The page is made to fit the window: the picture shrinks with the window's height, so there is nothing to scroll;
// only a window too small for everything scrolls. Rust (src/home_inbox.rs + main.rs home_fill) fills HomeState.
// The clip on show is Home card 0 (Card.idx = HOME_BASE), so hover / play / Copy / Share / Edit / Captions work
// through the same paths as before (Edit opens the editor directly; the picture is the sharp still).
import { T, Ic, Icon, TipArea, CopyMenuBody } from "theme.slint";
import { Card, CardView } from "library.slint";
import { PlayBadge } from "playbadge.slint";
import { Play } from "player.slint"; // 11 Nov 2026: the clip plays inside the picture (Play.inline)

export global HomeState {
    in-out property <[Card]> cards;        // [0] = the clip on show
    in-out property <image> hero;          // a sharp still of the clip on show (ffmpeg), else its card picture
    in-out property <string> hero-meta;    // "FiveM · 32 min ago"
    in-out property <length> hero-w;       // the picture's width - its hover video is made this big (hover_vid.rs)
    // 11 Nov 2026: where the picture is in the window - the clip plays right there (app.slint, Play.inline)
    in-out property <length> hero-x;
    in-out property <length> hero-y;
    in-out property <length> hero-h;
    // Inbox (home_inbox.rs)
    in-out property <bool> loading;        // the clips folder is still being read: show nothing yet
    in-out property <string> label;        // "NEW SINCE YOU LAST LOOKED" / "YOUR LATEST CLIP" / "YOUR CLIPS"
    in-out property <bool> new-mode;       // the pager goes through new clips (else through all clips)
    in-out property <int> pos;             // the clip on show in that list (0 = first)
    in-out property <int> count;
    in-out property <bool> can-prev;
    in-out property <bool> can-next;
    in-out property <[int]> dots;          // short lists of new clips: 0 done, 1 on show, 2 still new ([] = no dots)
    in-out property <[string]> det-l;      // CLIP DETAILS: Duration, Size, Resolution, Frame rate, Format, Folder
    in-out property <[string]> det-v;
    in-out property <[string]> det-sl;     // the short list for a small panel: Length, Picture, Format, Folder
    in-out property <[string]> det-sv;
    // Your games: one shelf per top folder (newest first); 3 pictures per shelf, flattened (sh-npics = how many real)
    in-out property <[string]> sh-id;
    in-out property <[string]> sh-name;
    in-out property <[string]> sh-sub;
    in-out property <[string]> sh-initial;
    in-out property <[image]> sh-icon;
    in-out property <[bool]> sh-has-icon;
    in-out property <[int]> sh-npics;
    in-out property <[image]> sh-pics;
    in-out property <[bool]> sh-game;      // a game (else a plain folder: folder icon, "folder · N clips")
    in-out property <[string]> sh-tail;    // names of shelves i.. ("Counter-Strike 2 · Mixed") for the "+N more" place
    in-out property <string> empty-key;    // the first hotkey, for the first-run card ("Shift+F11")
    in-out property <bool> test-hover;     // test hook ECHO_HOME_HOVER=1: the play button shows without a mouse (pictures)
    // still set by Rust (older Home parts, not shown any more)
    in-out property <int> extra;
    in-out property <string> week;
    in-out property <string> total;
    in-out property <string> size;
    in-out property <string> games;
    in-out property <string> games-word;
    in-out property <[int]> bars;
    in-out property <int> bars-max: 1;
    in-out property <bool> spark;
    in-out property <[int]> days;
    in-out property <[string]> day-l;
    in-out property <int> days-max: 1;
    in-out property <bool> gs-on;
    in-out property <[bool]> gs-done;
    in-out property <string> gs-title;
    in-out property <string> gs-text;
    in-out property <string> gs-go;
    // "copy" / "copy:<size>" / "edit" / "link" / "cap" / "play" / "library" / "prev" / "next" / "keep" / "del" /
    // "shelf:<filter id>"
    callback act(string);
    callback cols(int);
}

// a key on a button ("S"): Echo's kbd look, small
component KeyCap inherits Rectangle {
    in property <string> k;
    in property <bool> on-accent;
    height: 20px;
    width: max(20px, kt.preferred-width + 10px);
    border-radius: 5px;
    background: on-accent ? #ffffff33 : T.panel2;
    border-width: 1px;
    border-color: on-accent ? #ffffff4d : T.hover;
    kt := Text {
        text: root.k;
        font-size: 11px;
        font-weight: 600 + T.fw;
        color: root.on-accent ? T.on-accent : T.muted;
    }
}

// one button of the side panel: icon, label, its key on the right
component PanelBtn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> k;
    in property <bool> danger;
    in property <length> h: 42px;
    callback clicked;
    height: h;
    border-radius: 10px;
    border-width: 1px;
    border-color: ta.has-hover ? (danger ? T.bad.with-alpha(0.6) : T.hover) : T.line;
    background: ta.has-hover ? T.panel2 : T.panel2.with-alpha(0.6);
    animate background, border-color { duration: T.fade; enabled: !T.rgb-live; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 10px;
        Icon {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            commands: root.icon;
            stroke: root.danger ? T.bad : T.muted;
        }
        Text {
            text: root.text;
            font-size: 13.5px;
            font-weight: 600 + T.fw;
            color: root.danger ? T.bad : T.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.k != "": KeyCap {
            y: (parent.height - self.height) / 2;
            k: root.k;
        }
    }
}

// the pager's arrow
component PagerBtn inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled;
    in property <string> tip;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    border-width: 1px;
    border-color: T.line;
    background: ta.has-hover && root.enabled ? T.hover : T.panel2;
    opacity: root.enabled ? 1 : 0.4;
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
    TipArea {
        text: root.tip;
        hover: ta.has-hover;
    }
    Icon {
        width: 15px;
        height: 15px;
        commands: root.icon;
        stroke: T.muted;
    }
}

// one "Your games" shelf: icon + name (wraps, never cut off mid-word; very long names get … with the full name as a
// tooltip) + "21 clips · 2.1 GB" + Open on the left, its newest pictures stacked on the right
component Shelf inherits Rectangle {
    in property <string> name;
    in property <string> sub;
    in property <string> initial;
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> game: true;
    in property <int> npics;
    in property <image> p0;
    in property <image> p1;
    in property <image> p2;
    callback clicked;
    border-radius: 14px;
    border-width: 1px;
    border-color: ta.has-hover ? T.accent.with-alpha(0.5) : T.line;
    background: T.panel;
    animate border-color { duration: T.fade; enabled: !T.rgb-live; }
    clip: true;
    // the name gets its room first (at least 42 % of the shelf, so game names wrap instead of being cut); the
    // pictures take the rest: front one 16:9 at the right, up to 2 more peek out behind it when there is room
    property <length> info-min: max(120px, root.width * 0.42);
    property <length> avail: root.width - 16px - 16px - 14px - info-min;
    property <int> shown: npics <= 0 ? 0 : min(npics, avail >= 230px ? 3 : avail >= 160px ? 2 : 1);
    property <length> pw: max(0px, min((root.height - 32px) * 16 / 9, avail - max(0, shown - 1) * 22px));
    property <length> ph: pw * 9 / 16;
    property <length> stack-w: shown <= 0 ? 0px : pw + (shown - 1) * 22px;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    TipArea {
        text: nm.preferred-height > nm.height + 1px ? root.name : "";
        hover: ta.has-hover;
    }
    for k in [2, 1, 0]: Rectangle {
        visible: k < root.shown && root.pw > 40px;
        x: root.width - 16px - root.pw - k * 22px;
        y: (root.height - root.ph) / 2 - k * 6px;
        width: root.pw;
        height: root.ph;
        border-radius: 8px;
        clip: true;
        background: #000;
        border-width: 1px;
        border-color: #ffffff1f;
        drop-shadow-blur: 12px;
        drop-shadow-offset-x: -4px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: #00000066;
        Image {
            width: parent.width;
            height: parent.height;
            source: k == 0 ? root.p0 : k == 1 ? root.p1 : root.p2;
            image-fit: cover;
            opacity: k == 0 ? 1 : 0.85;
        }
    }
    VerticalLayout {
        x: 16px;
        y: 16px;
        width: max(60px, root.width - 16px - 16px - root.stack-w - 14px);
        height: root.height - 32px;
        spacing: 0;
        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 7px;
            background: root.has-icon ? transparent : T.accent.with-alpha(0.18);
            clip: true;
            if root.has-icon: Image {
                width: parent.width;
                height: parent.height;
                source: root.icon;
                image-fit: contain;
            }
            if !root.has-icon && root.game: Text {
                text: root.initial;
                font-size: 13px;
                font-weight: 700 + T.fw;
                color: T.accent2;
            }
            if !root.has-icon && !root.game: Icon {
                width: 16px;
                height: 16px;
                commands: Ic.folder;
                stroke: T.accent2;
            }
        }
        Rectangle { height: 8px; }
        nm := Text {
            text: root.name;
            font-size: 15px;
            font-weight: 700 + T.fw;
            color: T.text;
            wrap: word-wrap;
            overflow: elide;
            max-height: 40px; // two lines
        }
        Text {
            text: root.sub;
            font-size: 12px;
            color: T.muted;
            overflow: elide;
        }
        Rectangle { vertical-stretch: 1; }
        Text {
            text: "Open →";
            font-size: 12.5px;
            font-weight: 600 + T.fw;
            color: ta.has-hover ? T.accent2 : T.accent;
        }
    }
}

// QA B29: the last place of the shelf row when not all shelves fit - "+2 more", their names, opens the Library
component MoreShelf inherits Rectangle {
    in property <int> n;
    in property <string> names;
    callback clicked;
    border-radius: 14px;
    border-width: 1px;
    border-color: ta.has-hover ? T.accent.with-alpha(0.5) : T.line;
    background: ta.has-hover ? T.panel2 : T.panel;
    animate border-color, background { duration: T.fade; enabled: !T.rgb-live; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    TipArea {
        text: root.names;
        hover: ta.has-hover;
    }
    VerticalLayout {
        padding: 16px;
        spacing: 0;
        Text {
            text: "+" + root.n + " more";
            font-family: "Segoe UI Variable Display";
            font-size: 22px;
            font-weight: 700 + T.fw;
            color: T.text;
        }
        Rectangle { height: 6px; }
        Text {
            text: root.names;
            font-size: 12.5px;
            color: T.muted;
            wrap: word-wrap;
            overflow: elide;
            max-height: 52px; // three lines
        }
        Rectangle { vertical-stretch: 1; }
        Text {
            text: "All in the Library →";
            font-size: 12.5px;
            font-weight: 600 + T.fw;
            color: ta.has-hover ? T.accent2 : T.accent;
        }
    }
}

export component HomePage inherits Rectangle {
    background: transparent;
    in property <length> win-h; // (unused now: the page uses its own height)
    // ---- sizes: everything fits the page; the picture takes what is left ----
    property <length> pad-l: 28px;
    property <length> pad-r: 36px;
    property <length> pad-t: 24px;
    property <length> pad-b: 24px;
    property <length> cw: self.width - pad-l - pad-r;
    property <length> aw: self.width >= 1500px ? 360px : self.width >= 1300px ? 320px : 260px;
    property <length> head-h: 80px;   // label + title + "FiveM · 32 min ago"
    property <length> shelf-h: 150px;
    property <length> games-h: 28px + 32px + shelf-h; // gap + "Your games" row + one row of shelves
    property <length> fixed-h: pad-t + head-h + 16px + games-h + pad-b;
    property <length> vw: max(320px, min(cw - 24px - aw, (self.height - fixed-h) * 16 / 9));
    property <length> vh: vw * 9 / 16;
    // 11 Nov 2026: while the clip plays inside the picture it grows by the player's strip + bar (66 + 57), so the
    // video keeps its full 16:9 size
    // 12 Nov 2026: always (the clip sits loaded + paused there, playing or not looks the same)
    property <length> sh: root.vh + 123px;
    // the panel's size step: full (6 details rows + hint) / compact (4 rows, smaller buttons) / no details
    property <int> tier: aw >= 320px && vh >= 610px ? 0 : vh >= 430px ? 1 : 2;
    property <length> btn-h: tier == 0 ? 42px : 36px;
    property <length> page-w: vw + 24px + aw;
    property <int> shelf-cols: page-w >= 1400px ? 4 : page-w >= 1000px ? 3 : 2;
    property <length> shelf-w: (page-w - (shelf-cols - 1) * 16px) / shelf-cols;
    property <bool> has: HomeState.cards.length > 0;
    // the picture = the clip's card with the sharp still in it
    property <Card> c0: HomeState.cards[0];
    property <image> hero-img: HomeState.hero;
    property <Card> hero-card;
    function sync-hero() {
        self.hero-card = self.c0;
        self.hero-card.thumb = self.hero-img;
        self.hero-card.has-thumb = true;
    }
    changed c0 => { self.sync-hero(); }
    changed hero-img => { self.sync-hero(); }
    init => { self.sync-hero(); }

    fl := Flickable {
        width: parent.width;
        height: parent.height;
        // = the page's own height when everything fits (nothing to scroll); taller only in a very small window
        content-height: max(self.height, body.preferred-height);
        // 11 Nov 2026 (William): a click anywhere on Home outside the clip playing in the picture closes it - back to
        // the still with the play button (buttons, the picture and the player itself take their own clicks)
        if Play.inline-active: TouchArea {
            x: 0;
            y: 0;
            width: body.width;
            height: body.height;
            clicked => { Play.act("inline-stop"); }
        }
        body := VerticalLayout {
            width: fl.width;
            height: max(fl.height, self.preferred-height);
            padding-left: root.pad-l;
            padding-right: root.pad-r;
            padding-top: root.pad-t;
            padding-bottom: root.pad-b;
            spacing: 0;
            alignment: start;
            if HomeState.loading: Rectangle { }
            // ---------- first run: no clips yet ----------
            if !HomeState.loading && !root.has: VerticalLayout {
                spacing: 0;
                Text {
                    text: "NEW CLIPS";
                    font-size: 11px;
                    font-weight: 700 + T.fw;
                    letter-spacing: 1px;
                    color: T.dim;
                }
                Rectangle { height: 6px; }
                Text {
                    text: "Nothing here yet";
                    font-family: "Segoe UI Variable Display";
                    font-size: 26px;
                    font-weight: 700 + T.fw;
                    color: T.text;
                }
                Rectangle { height: 16px; }
                Rectangle {
                    height: min(360px, max(220px, root.height - 300px));
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: T.line;
                    background: T.panel;
                    VerticalLayout {
                        alignment: center;
                        spacing: 10px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                height: 48px;
                                width: ek.preferred-width + 36px;
                                border-radius: 10px;
                                background: T.panel2;
                                border-width: 1px;
                                border-color: T.hover;
                                Rectangle {
                                    y: parent.height - 5px;
                                    height: 5px;
                                    background: T.hover;
                                    border-bottom-left-radius: 10px;
                                    border-bottom-right-radius: 10px;
                                }
                                ek := Text {
                                    y: 8px;
                                    text: HomeState.empty-key;
                                    font-size: 20px;
                                    font-weight: 600 + T.fw;
                                    color: T.text;
                                }
                            }
                        }
                        Text {
                            text: "Play a game, press the key when something happens";
                            font-size: 17px;
                            font-weight: 700 + T.fw;
                            color: T.text;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Echo already keeps the last minutes. Your clip shows up here with big buttons to send it, trim it or throw it away.";
                            font-size: 13.5px;
                            color: T.muted;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
                Rectangle { height: 28px; }
                Text {
                    text: "Your games";
                    font-family: "Segoe UI Variable Display";
                    font-size: 15px;
                    font-weight: 700 + T.fw;
                    color: T.text;
                }
                Rectangle { height: 8px; }
                Text {
                    text: "Each game you clip gets a shelf here, with pictures from its clips.";
                    font-size: 13px;
                    color: T.muted;
                    wrap: word-wrap;
                }
            }
            // ---------- the clip on show ----------
            if !HomeState.loading && root.has: VerticalLayout {
                spacing: 0;
                width: root.page-w;
                // label + title + game · when
                VerticalLayout {
                    height: root.head-h;
                    spacing: 0;
                    alignment: start;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: HomeState.label;
                            font-size: 11px;
                            font-weight: 700 + T.fw;
                            letter-spacing: 1px;
                            color: T.dim;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { height: 6px; }
                    Text {
                        text: HomeState.cards[0].title;
                        font-family: "Segoe UI Variable Display";
                        font-size: 26px;
                        font-weight: 700 + T.fw;
                        color: T.text;
                        overflow: elide;
                    }
                    Rectangle { height: 2px; }
                    HorizontalLayout {
                        spacing: 7px;
                        alignment: start;
                        if HomeState.cards[0].has-gicon: Image {
                            y: (parent.height - self.height) / 2;
                            width: 18px;
                            height: 18px;
                            source: HomeState.cards[0].gicon;
                            image-fit: contain;
                        }
                        Text {
                            text: HomeState.hero-meta;
                            font-size: 13px;
                            color: T.muted;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
                Rectangle { height: 16px; }
                HorizontalLayout {
                    spacing: 24px;
                    alignment: start;
                    height: max(root.sh, panel.need-h);
                    // the picture: the clip's card (badges, hover video, click plays) with the sharp still
                    shot := Rectangle {
                        width: root.vw;
                        height: root.sh;
                        y: 0;
                        border-radius: 14px;
                        background: #0a0a0c;
                        clip: true;
                        init => {
                            HomeState.hero-w = self.width;
                            HomeState.hero-h = self.height;
                            HomeState.hero-x = self.absolute-position.x;
                            HomeState.hero-y = self.absolute-position.y;
                        }
                        changed width => { HomeState.hero-w = self.width; }
                        changed height => { HomeState.hero-h = self.height; }
                        changed absolute-position => {
                            HomeState.hero-x = self.absolute-position.x;
                            HomeState.hero-y = self.absolute-position.y;
                        }
                        property <bool> hov: pta.has-hover;
                        CardView {
                            x: -1px;
                            y: -1px;
                            width: parent.width + 2px;
                            height: root.vh + 2px; // the video's part (the strip + bar under it come with the clip)
                            data: root.hero-card;
                        }
                        // 11 Nov 2026 (William: "remove hover to play, only for the Home player"): this takes the mouse over
                        // the picture, so the card under it never starts its hover preview; a click plays it here
                        pta := TouchArea {
                            height: root.vh;
                            y: 0;
                            mouse-cursor: pointer;
                            clicked => { HomeState.act("play"); }
                        }
                        // Echo's shared play button (playbadge.slint): shows while the mouse is on the picture
                        PlayBadge {
                            size: clamp(root.vh * 0.09, 44px, 56px); // 11 Nov 2026: smaller (was 56-84 px)
                            hover: parent.hov;
                            y: (root.vh - self.height) / 2;
                            opacity: parent.hov || HomeState.test-hover ? 1 : 0;
                            animate opacity { duration: 180ms; }
                        }
                    }
                    // ---------- the side panel: pager, buttons, details - as tall as the picture ----------
                    panel := Rectangle {
                        out property <length> need-h: pl.preferred-height;
                        width: root.aw;
                        height: max(root.sh, pl.preferred-height);
                        y: 0;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: T.line;
                        background: T.panel;
                        pl := VerticalLayout {
                            padding-left: root.tier == 0 ? 16px : 14px;
                            padding-right: root.tier == 0 ? 16px : 14px;
                            padding-top: root.tier == 0 ? 14px : 12px;
                            padding-bottom: root.tier == 0 ? 12px : 10px;
                            spacing: 0;
                            // QA E12: without the clip details (small sizes) the buttons stay under the pager (space-between
                            // left a ~170 px gap above them)
                            alignment: root.tier < 2 ? LayoutAlignment.space-between : LayoutAlignment.start;
                            // pager
                            HorizontalLayout {
                                spacing: 8px;
                                PagerBtn {
                                    y: (parent.height - self.height) / 2;
                                    icon: Ic.prev;
                                    enabled: HomeState.can-prev;
                                    tip: "Back (←)";
                                    clicked => { HomeState.act("prev"); }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 5px;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text {
                                            text: (HomeState.pos + 1) + " of " + HomeState.count;
                                            font-size: 14px;
                                            font-weight: 700 + T.fw;
                                            color: T.text;
                                        }
                                        if HomeState.new-mode: Text {
                                            text: "new";
                                            font-size: 13px;
                                            color: T.muted;
                                        }
                                    }
                                    if HomeState.dots.length > 0: HorizontalLayout {
                                        alignment: center;
                                        spacing: 5px;
                                        for d in HomeState.dots: Rectangle {
                                            width: d == 1 ? 18px : 7px;
                                            height: 7px;
                                            border-radius: 4px;
                                            background: d == 1 ? T.accent : d == 0 ? T.accent.with-alpha(0.45) : T.line;
                                        }
                                    }
                                }
                                PagerBtn {
                                    y: (parent.height - self.height) / 2;
                                    icon: Ic.next;
                                    enabled: HomeState.can-next;
                                    tip: "Next (→)";
                                    clicked => { HomeState.act("next"); }
                                }
                            }
                            // buttons
                            VerticalLayout {
                                spacing: 0;
                                Rectangle { height: root.tier == 0 ? 14px : 10px; }
                                Rectangle { height: 1px; background: T.line; }
                                Rectangle { height: root.tier == 0 ? 14px : 10px; }
                                VerticalLayout {
                                    spacing: root.tier == 0 ? 8px : 6px;
                                    // Copy for Discord + ▾ (sizes)
                                    HorizontalLayout {
                                        height: root.btn-h + 8px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-top-left-radius: 10px;
                                            border-bottom-left-radius: 10px;
                                            background: cta.has-hover ? T.accent.brighter(0.12) : T.accent;
                                            cta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { HomeState.act("copy"); }
                                            }
                                            HorizontalLayout {
                                                padding-left: 14px;
                                                padding-right: 10px;
                                                spacing: 10px;
                                                Icon {
                                                    y: (parent.height - self.height) / 2;
                                                    width: 18px;
                                                    height: 18px;
                                                    commands: "M8 9h.01M16 9h.01 M5 5h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-5l-4 3v-3H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z";
                                                    stroke: T.on-accent;
                                                }
                                                Text {
                                                    text: "Copy for Discord";
                                                    font-size: 14.5px;
                                                    font-weight: 600 + T.fw;
                                                    color: T.on-accent;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                    overflow: elide;
                                                }
                                                // playing: S cuts (the player's key) - no chip then (an empty one drew a box)
                                                if !Play.inline-active: KeyCap {
                                                    y: (parent.height - self.height) / 2;
                                                    k: "S";
                                                    on-accent: true;
                                                }
                                            }
                                        }
                                        Rectangle {
                                            width: 38px;
                                            border-top-right-radius: 10px;
                                            border-bottom-right-radius: 10px;
                                            background: ata.has-hover ? T.accent.brighter(0.12) : T.accent;
                                            Rectangle {
                                                x: 0;
                                                width: 1px;
                                                background: #ffffff40;
                                            }
                                            ata := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { cm.show(); }
                                            }
                                            cm := PopupWindow {
                                                x: parent.width - self.width;
                                                y: parent.height + 6px;
                                                width: cmb.preferred-width;
                                                height: cmb.preferred-height;
                                                close-policy: close-on-click-outside;
                                                cmb := CopyMenuBody {
                                                    size-text: HomeState.cards[0].size;
                                                    picked(k) => {
                                                        cm.close();
                                                        HomeState.act("copy:" + k);
                                                    }
                                                    cancel => { cm.close(); }
                                                }
                                            }
                                            TipArea {
                                                text: "Choose the size";
                                                hover: ata.has-hover;
                                            }
                                            Icon {
                                                width: 13px;
                                                height: 13px;
                                                stroke-width: 2.4px;
                                                commands: Ic.down;
                                                stroke: T.on-accent;
                                            }
                                        }
                                    }
                                    PanelBtn {
                                        h: root.btn-h;
                                        text: "Share link";
                                        icon: Ic.link;
                                        k: Play.inline-active ? "" : "L"; // playing: L = +10 s (player)
                                        clicked => { HomeState.act("link"); }
                                    }
                                    PanelBtn {
                                        h: root.btn-h;
                                        text: "Trim / edit";
                                        icon: Ic.trim;
                                        k: "E";
                                        clicked => { HomeState.act("edit"); }
                                    }
                                    PanelBtn {
                                        h: root.btn-h;
                                        text: "Captions";
                                        icon: Ic.cc;
                                        clicked => { HomeState.act("cap"); }
                                    }
                                    Rectangle { height: root.tier == 0 ? 4px : 2px; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        PanelBtn {
                                            horizontal-stretch: 1;
                                            h: root.btn-h;
                                            text: "Keep";
                                            icon: Ic.star;
                                            k: root.aw >= 320px && !Play.inline-active ? "K" : ""; // playing: K = pause
                                            clicked => { HomeState.act("keep"); }
                                        }
                                        PanelBtn {
                                            horizontal-stretch: 1;
                                            h: root.btn-h;
                                            text: "Delete";
                                            icon: Ic.del;
                                            k: root.aw >= 320px ? "Del" : "";
                                            danger: true;
                                            clicked => { HomeState.act("del"); }
                                        }
                                    }
                                    if root.tier == 0: Text {
                                        text: HomeState.new-mode ? "Keep = star it, then the next new clip. → skips it." : "Keep = star it, then the next clip.";
                                        font-size: 12px;
                                        color: T.muted;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                            // CLIP DETAILS
                            if root.tier < 2: VerticalLayout {
                                spacing: 0;
                                Rectangle { height: root.tier == 0 ? 14px : 10px; }
                                Rectangle { height: 1px; background: T.line; }
                                Rectangle { height: root.tier == 0 ? 14px : 10px; }
                                Text {
                                    text: "CLIP DETAILS";
                                    font-size: 11px;
                                    font-weight: 700 + T.fw;
                                    letter-spacing: 1px;
                                    color: T.dim;
                                }
                                Rectangle { height: 4px; }
                                for l[i] in (root.tier == 0 ? HomeState.det-l : HomeState.det-sl): HorizontalLayout {
                                    height: root.tier == 0 ? 30px : 24px;
                                    spacing: 9px;
                                    Icon {
                                        y: (parent.height - self.height) / 2;
                                        width: 15px;
                                        height: 15px;
                                        stroke: T.dim;
                                        commands: root.tier == 0
                                            ? (i == 0 ? "M4 4h16v16H4z M8 4v16 M16 4v16 M4 9h4 M4 15h4 M16 9h4 M16 15h4"
                                               : i == 1 ? "M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3z M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6"
                                               : i == 2 ? "M3 5h18v11H3z M8 20h8 M12 16v4"
                                               : i == 3 ? "M12 14l4-4 M3 15a9 9 0 0 1 18 0"
                                               : i == 4 ? "M14 3H6v18h12V7z M14 3v4h4" : Ic.folder)
                                            : (i == 0 ? "M4 4h16v16H4z M8 4v16 M16 4v16 M4 9h4 M4 15h4 M16 9h4 M16 15h4"
                                               : i == 1 ? "M3 5h18v11H3z M8 20h8 M12 16v4"
                                               : i == 2 ? "M14 3H6v18h12V7z M14 3v4h4" : Ic.folder);
                                    }
                                    Text {
                                        text: l;
                                        font-size: 12.5px;
                                        color: T.muted;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.tier == 0 ? HomeState.det-v[i] : HomeState.det-sv[i];
                                        font-size: 12.5px;
                                        font-weight: 600 + T.fw;
                                        color: T.text;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
                // ---------- Your games ----------
                Rectangle { height: 28px; }
                HorizontalLayout {
                    height: 20px;
                    Text {
                        text: "Your games";
                        font-family: "Segoe UI Variable Display";
                        font-size: 15px;
                        font-weight: 700 + T.fw;
                        color: T.text;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Library →";
                        font-size: 12.5px;
                        color: lba.has-hover ? T.accent2 : T.accent;
                        vertical-alignment: center;
                        lba := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { HomeState.act("library"); }
                        }
                    }
                }
                Rectangle { height: 12px; }
                if HomeState.sh-id.length == 0: Text {
                    height: root.shelf-h;
                    text: "Each game you clip gets a shelf here, with pictures from its clips.";
                    font-size: 13px;
                    color: T.muted;
                    vertical-alignment: top;
                    wrap: word-wrap;
                }
                if HomeState.sh-id.length > 0: Rectangle {
                    height: root.shelf-h;
                    property <bool> over: HomeState.sh-id.length > root.shelf-cols;
                    property <int> shown: self.over ? root.shelf-cols - 1 : root.shelf-cols;
                    for s[i] in HomeState.sh-id: Shelf {
                        visible: i < parent.shown;
                        x: i * (root.shelf-w + 16px);
                        width: root.shelf-w;
                        height: root.shelf-h;
                        name: HomeState.sh-name[i];
                        sub: HomeState.sh-sub[i];
                        initial: HomeState.sh-initial[i];
                        icon: HomeState.sh-icon[i];
                        has-icon: HomeState.sh-has-icon[i];
                        game: HomeState.sh-game[i];
                        npics: HomeState.sh-npics[i];
                        p0: HomeState.sh-pics[i * 3];
                        p1: HomeState.sh-pics[i * 3 + 1];
                        p2: HomeState.sh-pics[i * 3 + 2];
                        clicked => { HomeState.act("shelf:" + s); }
                    }
                    if self.over: MoreShelf {
                        x: parent.shown * (root.shelf-w + 16px);
                        width: root.shelf-w;
                        height: root.shelf-h;
                        n: HomeState.sh-id.length - parent.shown;
                        names: HomeState.sh-tail[parent.shown];
                        clicked => { HomeState.act("library"); }
                    }
                }
            }
        }
    }
}
