// Chat D - the Screenshots page: pictures in <clips>/Screenshots (Echo's P / screenshot hotkey / player Frame).
// Click = open it in the system's picture viewer; hover = Show in folder / Delete. Rust: src/lib_shots.rs.
import { T, Ic, Icon, IconBtn, Btn, TipArea } from "theme.slint";
import { Focus } from "focus.slint"; // port leftovers L2

export struct Shot {
    name: string,
    when: string,     // "5 min ago · 1.2 MB"
    img: image,
    picked: bool,     // gaps-library row 12: selected (round tick, Ctrl/Shift+click, Ctrl+A)
}

export global Shots {
    in-out property <[Shot]> items;
    in-out property <string> count;    // "12 screenshots · 30 MB"
    in-out property <int> cols: 4;
    // William (9 Nov): Echo's openShot in the app (was: Windows' viewer / Paint) - Rust fills these
    in-out property <bool> view-open;
    in property <image> view-img;
    in property <float> view-w;        // the picture's pixel size (aspect)
    in property <float> view-h;
    callback open(int);
    callback act(int, string);         // "copy" / "folder" / "delete"
    callback open-folder();
    // gaps-library row 12: Echo's selection, search and Grid/List on this page too (lib_shots.rs)
    in-out property <int> picked-n;
    in-out property <string> query;    // the page's search box (filters by name)
    callback pick(int);                // toggle one
    callback pick-all();               // Ctrl+A: what the page shows
    callback pick-clear();             // Clear / Esc
    callback del-picked();             // the bar's Delete / the Delete key
    callback search(string);
    callback set-view(bool);           // Grid / List (the library's setting, remembered)
}

// Echo's openShot + wheelZoom: dark overlay (#000e), the picture fitted inside 24 px padding (rounded 8 px, shadow);
// wheel = zoom toward the mouse (1.2x per notch, up to 8x), drag = move around while zoomed, click = close (only when
// not zoomed - a drag never counts as a click), Esc = close
export component ShotViewer inherits Rectangle {
    visible: Shots.view-open;
    background: #000000ee;
    property <length> aw: root.width - 48px;
    property <length> ah: root.height - 48px;
    // fitted size (keeps the aspect)
    property <float> fit: min(aw / 1px / max(1, Shots.view-w), ah / 1px / max(1, Shots.view-h), 1);
    property <length> bw: Shots.view-w * fit * 1px;
    property <length> bh: Shots.view-h * fit * 1px;
    property <length> bx: (root.width - bw) / 2;
    property <length> by: (root.height - bh) / 2;
    property <float> s: 1;
    property <length> ox;
    property <length> oy;
    property <bool> dragged;
    property <length> dx0;
    property <length> dy0;
    property <length> ox0;
    property <length> oy0;
    changed visible => {
        root.s = 1;
        root.ox = 0;
        root.oy = 0;
        if (root.visible) {
            fs.focus();
        } else {
            Focus.back(); // L2: Esc / click closes the viewer - the Screenshots page gets the keys again
        }
    }
    function clamp-pan() {
        root.ox = min(0px, max(root.bw * (1 - root.s), root.ox));
        root.oy = min(0px, max(root.bh * (1 - root.s), root.oy));
    }
    ta := TouchArea {
        mouse-cursor: root.s > 1 ? (self.pressed ? MouseCursor.grabbing : MouseCursor.grab) : MouseCursor.pointer;
        scroll-event(e) => {
            // main.rs hands one wheel notch out as glide steps adding up to 160 px: 1.2x per 160 px
            let px = (self.mouse-x - root.bx - root.ox) / root.s;
            let py = (self.mouse-y - root.by - root.oy) / root.s;
            let ns = min(8, max(1, root.s * pow(1.2, e.delta-y / 160px)));
            root.ox = self.mouse-x - root.bx - px * ns;
            root.oy = self.mouse-y - root.by - py * ns;
            root.s = ns < 1.02 ? 1 : ns;
            if (root.s == 1) {
                root.ox = 0;
                root.oy = 0;
            }
            root.clamp-pan();
            accept
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.dragged = false;
                root.dx0 = self.mouse-x;
                root.dy0 = self.mouse-y;
                root.ox0 = root.ox;
                root.oy0 = root.oy;
            }
        }
        moved => {
            if (self.pressed && root.s > 1) {
                if (abs(self.mouse-x - root.dx0) + abs(self.mouse-y - root.dy0) > 4px) {
                    root.dragged = true;
                }
                root.ox = root.ox0 + self.mouse-x - root.dx0;
                root.oy = root.oy0 + self.mouse-y - root.dy0;
                root.clamp-pan();
            }
        }
        clicked => {
            if (root.s <= 1 && !root.dragged) {
                Shots.view-open = false;
            }
            root.dragged = false;
        }
    }
    Rectangle {
        x: root.bx + root.ox;
        y: root.by + root.oy;
        width: root.bw * root.s;
        height: root.bh * root.s;
        border-radius: 8px;
        clip: true;
        drop-shadow-blur: 60px;
        drop-shadow-offset-y: 20px;
        drop-shadow-color: #000000;
        Image {
            width: parent.width;
            height: parent.height;
            source: Shots.view-img;
            image-fit: fill;
        }
    }
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                Shots.view-open = false;
                return accept;
            }
            reject
        }
    }
}

// Echo's .pick on a screenshot (gaps-library row 12): round tick, shows on hover / while selecting
component ShotTick inherits Rectangle {
    in property <bool> on;
    in property <bool> show;
    callback clicked;
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background: on ? T.accent : #00000066;
    border-width: 2px;
    border-color: on ? T.accent : #ffffffcc;
    opacity: show || on ? 1 : 0;
    animate opacity { duration: T.fade; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    TipArea {
        text: "Select (Ctrl+click)";
        hover: ta.has-hover;
    }
    if root.on: Icon {
        width: 14px;
        height: 14px;
        commands: Ic.check;
        stroke: white;
        stroke-width: 3px;
    }
}

component ShotCard inherits Rectangle {
    in property <Shot> s;
    in property <int> i;
    in property <bool> small; // list view: the picture on the left
    property <bool> hov: ta.has-hover;
    property <bool> sel-click; // Ctrl / Shift held on the press
    property <length> pic-w: small ? 176px : self.width - 2px;
    property <length> pic-h: small ? self.height - 2px : pic-w * 9 / 16;
    background: T.panel;
    border-radius: T.radius;
    border-width: 1px;
    border-color: s.picked ? T.accent : hov ? T.accent.with-alpha(0.4) : T.line;
    animate border-color { duration: T.fade; }
    clip: true;
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.sel-click = e.modifiers.control || e.modifiers.shift;
            }
        }
        // Echo: Ctrl / Shift+click or a click while something is selected = select, else open the picture
        clicked => {
            if (root.sel-click || Shots.picked-n > 0) {
                Shots.pick(root.i);
            } else {
                Shots.open(root.i);
            }
        }
    }
    Rectangle {
        x: 1px;
        y: 1px;
        width: root.pic-w;
        height: root.pic-h;
        background: #0a0a0c;
        clip: true;
        Image {
            width: 100%;
            height: 100%;
            source: s.img;
            image-fit: cover;
        }
        // selected: accent tint; something else selected: this one is dimmed (like the clip cards)
        Rectangle {
            background: s.picked ? T.accent.with-alpha(0.16) : Shots.picked-n > 0 ? (root.hov ? #0a0a0c26 : #0a0a0c73) : transparent;
            animate background { duration: T.fade; }
        }
        ShotTick {
            x: 9px;
            y: 9px;
            on: s.picked;
            show: root.hov || Shots.picked-n > 0;
            clicked => { Shots.pick(root.i); }
        }
    }
    HorizontalLayout {
        x: root.small ? root.pic-w + 2px : 0;
        y: root.small ? 0 : root.pic-h + 1px;
        width: parent.width - self.x;
        height: parent.height - self.y;
        padding-left: 14px;
        padding-right: 8px;
        spacing: 6px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: s.name;
                font-size: 14px;
                font-weight: 600 + T.fw;
                color: T.text;
                overflow: elide;
            }
            Text {
                text: s.when;
                font-size: 12px;
                color: T.muted;
                overflow: elide;
            }
        }
        if hov: IconBtn {
            y: (parent.height - self.height) / 2;
            icon: Ic.copy;
            tip: "Copy to clipboard";
            clicked => { Shots.act(root.i, "copy"); }
        }
        if hov: IconBtn {
            y: (parent.height - self.height) / 2;
            icon: Ic.folder;
            tip: "Show in folder";
            clicked => { Shots.act(root.i, "folder"); }
        }
        if hov: IconBtn {
            y: (parent.height - self.height) / 2;
            icon: Ic.del;
            danger: true;
            tip: "Delete";
            clicked => { Shots.act(root.i, "delete"); }
        }
    }
}

export component ShotsPage inherits Rectangle {
    in property <bool> list; // the library's Grid / List setting (Echo's libView applies here too)
    property <length> gap: list ? 10px : 22px;
    property <int> cols: list ? 1 : root.width > 1240px ? 4 : root.width > 860px ? 3 : root.width > 500px ? 2 : 1;
    property <length> cw: (root.width - 56px - 8px - (cols - 1) * gap) / cols;
    property <length> ch: list ? 101px : cw * 9 / 16 + 2px + 58px;
    VerticalLayout {
        padding-left: 28px;
        padding-right: 28px;
        padding-top: 4px;
        spacing: 12px;
        HorizontalLayout {
            height: 36px;
            spacing: 12px;
            Text {
                text: Shots.count;
                font-size: 14px;
                color: T.muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            // gaps-library row 12: Echo's toolbar search (by name) on this page
            Rectangle {
                width: 260px;
                border-radius: 10px;
                background: T.panel;
                border-width: 1px;
                border-color: qi.has-focus ? T.accent : T.line;
                TouchArea {
                    mouse-cursor: MouseCursor.text;
                    clicked => { qi.focus(); }
                }
                Icon {
                    x: 11px;
                    y: 10px;
                    width: 16px;
                    height: 16px;
                    commands: Ic.search;
                    stroke: T.dim;
                }
                if qi.text == "": Text {
                    x: 34px;
                    height: parent.height;
                    text: "Search clips…";
                    font-size: 14px;
                    color: T.dim;
                    vertical-alignment: center;
                }
                qi := TextInput {
                    x: 34px;
                    width: parent.width - 46px;
                    height: parent.height;
                    text <=> Shots.query;
                    vertical-alignment: center;
                    single-line: true;
                    font-size: 14px;
                    color: T.text;
                    selection-background-color: T.accent.with-alpha(0.45);
                    edited => { Shots.search(self.text); }
                    key-pressed(e) => {
                        if (e.text == Key.Escape) {
                            // L46: like the library's search: Esc also clears a selection
                            if (Shots.picked-n > 0) {
                                Shots.pick-clear();
                            }
                            self.text = "";
                            Shots.search("");
                            self.clear-focus();
                            Focus.back(); // L2: clear-focus alone left no one with the keys
                            return accept;
                        }
                        reject
                    }
                }
            }
            IconBtn {
                y: 1px;
                icon: root.list ? Ic.grid : Ic.list;
                tip: "Grid / list view";
                icon-color: T.text;
                idle-bg: T.panel;
                clicked => { Shots.set-view(!root.list); }
            }
            Btn {
                text: "Open folder";
                icon: Ic.folder;
                clicked => { Shots.open-folder(); }
            }
        }
        if Shots.items.length == 0: Text {
            vertical-stretch: 1;
            text: "No screenshots yet - press your screenshot hotkey in a game, or P in the player.";
            font-size: 14px;
            color: T.muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if Shots.items.length > 0: Flickable {
            vertical-stretch: 1;
            // + room under the last row for the selection bar
            content-height: (ceil(Shots.items.length / root.cols)) * (root.ch + root.gap) + 90px;
            for s[i] in Shots.items: ShotCard {
                x: mod(i, root.cols) * (root.cw + root.gap);
                y: floor(i / root.cols) * (root.ch + root.gap);
                width: root.cw;
                height: root.ch;
                s: s;
                i: i;
                small: root.list;
            }
        }
    }
    // Echo's .pickbar.shots: "N screenshots selected" [Delete] [Clear] (Combine / Move / AV1 / Favourite hidden)
    if Shots.picked-n > 0: Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 22px;
        width: sbl.preferred-width;
        height: 54px;
        background: T.panel2;
        border-radius: 12px;
        border-width: 1px;
        border-color: T.accent;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: #000000cc;
        TouchArea { }
        sbl := HorizontalLayout {
            padding-left: 16px;
            padding-right: 10px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 8px;
            Text {
                text: Shots.picked-n + " screenshot" + (Shots.picked-n == 1 ? "" : "s") + " selected";
                font-size: 14px;
                font-weight: 700 + T.fw;
                color: T.text;
                vertical-alignment: center;
            }
            Rectangle { width: 16px; }
            Btn {
                text: "Delete";
                icon: Ic.del;
                danger: true;
                clicked => { Shots.del-picked(); }
            }
            Btn {
                text: "Clear";
                tip: "Clear the selection (Esc)";
                tip-above: true;
                clicked => { Shots.pick-clear(); }
            }
        }
    }
}
