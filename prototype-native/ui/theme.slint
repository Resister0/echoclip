// Tooltip shown by TipLayer (one for the whole window). Owners set it after a short hover.
export global Tip {
    in-out property <string> text;
    in-out property <length> x;      // centre of the owner
    in-out property <length> top;    // owner's top
    in-out property <length> bottom; // owner's bottom
    in-out property <bool> on;
    in-out property <int> owner;     // a number per owner, so leaving one doesn't hide another's tip
    in-out property <int> next-id: 1;
    in-out property <int> alive;     // the owner bumps this while hovered; if it stops (owner removed), the tip hides
    in-out property <bool> above;    // the owner wants it above (bars at the bottom of the window)
}

// Short message at the bottom (like Echo's toast)
export global Toast {
    in-out property <string> text;
    in-out property <int> seq; // bumps on every message (restarts the hide timer)
}

export component Icon inherits Path {
    viewbox-width: 24;
    viewbox-height: 24;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
    width: 20px;
    height: 20px;
}

// Put inside any element with a TouchArea: shows `text` as a tooltip after 500 ms of hover.
export component TipArea {
    in property <string> text;
    in property <bool> hover;
    in property <bool> above;
    property <int> id: 0;
    init => {
        self.id = Tip.next-id;
        Tip.next-id += 1;
    }
    Timer {
        interval: 500ms;
        running: root.hover && root.text != "" && !(Tip.on && Tip.owner == root.id);
        triggered => {
            Tip.text = root.text;
            Tip.x = root.absolute-position.x + root.width / 2;
            Tip.top = root.absolute-position.y;
            Tip.bottom = root.absolute-position.y + root.height;
            Tip.owner = root.id;
            Tip.above = root.above;
            Tip.on = true;
        }
    }
    Timer {
        interval: 150ms;
        running: root.hover && Tip.on && Tip.owner == root.id;
        triggered => { Tip.alive += 1; }
    }
    changed hover => {
        if (!self.hover && Tip.owner == self.id) {
            Tip.on = false;
        }
    }
}

export component TipLayer {
    // fills the window; draws the tooltip under (or above, near the bottom) its owner
    property <int> last-alive;
    // r2-layout (L1): Windows - the video's own window covers anything Slint draws there: a tooltip that would land on
    // it goes to the other side of its owner instead (the player / editor bar buttons)
    in property <bool> avoid;
    in property <length> ax;
    in property <length> ay;
    in property <length> aw;
    in property <length> ah;
    Timer {
        interval: 400ms;
        running: Tip.on;
        triggered => {
            if (Tip.alive == root.last-alive) {
                Tip.on = false;
            }
            root.last-alive = Tip.alive;
        }
    }
    if Tip.on: Rectangle {
        property <length> w: min(tt.preferred-width + 20px, 320px);
        property <length> y-below: Tip.bottom + 8px;
        property <length> y-above: Tip.top - self.height - 8px;
        property <bool> want-below: !Tip.above && self.y-below + self.height < root.height;
        property <bool> x-on-video: root.avoid && self.x < root.ax + root.aw && self.x + self.w > root.ax;
        property <bool> below-hits: self.x-on-video && self.y-below < root.ay + root.ah && self.y-below + self.height > root.ay;
        property <bool> above-hits: self.x-on-video && self.y-above < root.ay + root.ah && self.y-above + self.height > root.ay;
        x: clamp(Tip.x - self.w / 2, 6px, root.width - self.w - 6px);
        y: self.want-below
            ? (self.below-hits && !self.above-hits && self.y-above >= 0 ? self.y-above : self.y-below)
            : (self.above-hits && !self.below-hits && self.y-below + self.height <= root.height ? self.y-below : self.y-above);
        width: self.w;
        height: tt.preferred-height + 12px;
        background: T.panel2;
        border-radius: 7px;
        border-width: 1px;
        border-color: T.hover;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000080;
        tt := Text {
            x: 10px;
            width: parent.width - 20px;
            text: Tip.text;
            font-size: 12px;
            color: T.text;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}

// Echo's #notes: ONE column at the bottom centre, newest at the bottom, gap 8 - messages (.note.msg, at most 3,
// the same text again only restarts its timer) and progress boxes (.note.prog: spinner, title, text, bar, optional
// button). Everything goes through this stack, so two jobs (e.g. shrinking for Discord + making a share link) can
// never cover each other. Rust owns the list (main.rs notes::*).
export struct Note {
    id: int,
    prog: bool,       // progress box (else a message)
    title: string,    // message text / box title
    text: string,     // box: text on the right (or under the bar when there is a button)
    pct: float,       // box: 0..100, < 0 = no bar
    fin: bool,        // box: finished (spinner stops)
    btn: string,      // box: small button ("Cancel" ...), "" = none
    out: bool,        // fading out (Rust removes it a moment later)
}

export global Notes {
    in-out property <[Note]> items;
    callback btn(int);   // a box's button
}

component Spinner inherits Rectangle {
    in property <bool> still;
    width: 11px;
    height: 11px;
    border-radius: 5.5px;
    border-width: 2px;
    border-color: still ? T.hi : T.line;
    // the coloured quarter (border-top-color in Echo), turning once per 0.8 s
    if !root.still: Path {
        width: 11px;
        height: 11px;
        viewbox-width: 11;
        viewbox-height: 11;
        stroke: T.hi;
        stroke-width: 2px;
        fill: transparent;
        commands: "M 1.6 3.3 A 4.5 4.5 0 0 1 9.4 3.3";
        transform-rotation: mod(animation-tick() / 1ms, 800) / 800 * 360deg;
    }
}

component NoteView inherits Rectangle {
    in property <Note> n;
    in property <length> avail;
    property <bool> shown;
    init => { self.shown = true; }
    property <bool> on: shown && !n.out;
    opacity: on ? 1 : 0;
    animate opacity { duration: 200ms; }
    height: n.prog ? box.preferred-height : max(40px, mt.preferred-height + 22px);
    // the panel (msg: text width + padding; prog: 400 px)
    property <length> w: n.prog ? min(400px, avail) : min(mt.preferred-width + 36px + 2px, avail);
    Rectangle {
        x: (parent.width - root.w) / 2;
        y: root.on ? 0 : 14px;
        animate y { duration: 200ms; }
        width: root.w;
        height: parent.height;
        background: T.panel2;
        border-radius: n.prog ? 12px : 11px;
        border-width: 1px;
        border-color: T.line;
        drop-shadow-blur: 30px;
        drop-shadow-offset-y: 10px;
        drop-shadow-color: #00000088;
        TouchArea { }
        mt := Text {
                visible: !n.prog;
                x: 18px;
                width: parent.width - 36px;
                height: parent.height;
                text: n.title;
                font-size: 14px;
                color: T.text;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        box := VerticalLayout {
            visible: n.prog;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 0;
            HorizontalLayout {
                spacing: 8px;
                Spinner {
                    y: (parent.height - self.height) / 2;
                    still: n.fin;
                }
                Text {
                    text: n.title;
                    font-size: 13px;
                    font-weight: 700 + T.fw;
                    color: T.text;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                if n.btn == "": Text {
                    text: n.text;
                    font-size: 13px;
                    color: T.muted;
                    vertical-alignment: center;
                }
                if n.btn != "": Rectangle {
                    width: bt.preferred-width + 18px;
                    height: 22px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 7px;
                    border-width: 1px;
                    border-color: bta.has-hover ? T.muted : T.line;
                    bt := Text {
                        text: n.btn;
                        font-size: 12px;
                        color: bta.has-hover ? T.text : T.muted;
                    }
                    bta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Notes.btn(n.id); }
                    }
                }
            }
            if n.pct >= 0: VerticalLayout {
                padding-top: 8px;
                Rectangle {
                    height: 6px;
                    border-radius: 3px;
                    background: T.panel;
                    clip: true;
                    Rectangle {
                        x: 0;
                        width: parent.width * clamp(n.pct, 0, 100) / 100;
                        animate width { duration: 200ms; }
                        background: T.hi;
                        border-radius: 3px;
                    }
                }
            }
            // with a button, the text goes under the bar (the title stays readable; .sub margin-top 6)
            if n.btn != "" && n.text != "": Rectangle { height: 6px; }
            if n.btn != "" && n.text != "": Text {
                text: n.text;
                font-size: 13px;
                color: T.muted;
                overflow: elide;
            }
        }
    }
}

export component ToastLayer {
    in property <length> lift;   // the selection bar is showing: Echo moves #notes up (bottom 84 instead of 24)
    property <length> avail: min(560px, root.width * 0.92);
    col := VerticalLayout {
        x: (root.width - root.avail) / 2;
        width: root.avail;
        y: root.height - self.preferred-height - 24px - root.lift;
        animate y { duration: 200ms; }
        spacing: 8px;
        for n in Notes.items: NoteView {
            n: n;
            avail: root.avail;
        }
    }
}

// Echo's .ib: 34 px icon button, no border, muted icon; hover = panel2 + bright icon
export component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    in property <bool> on;          // star: yellow + filled
    in property <bool> danger;      // delete: red on hover
    in property <length> size: 34px;
    in property <length> icon-size: 17px;
    in property <brush> idle-bg: transparent;
    in property <color> icon-color: T.muted;
    in property <float> idle-opacity: 1; // William: toolbar controls slightly see-through until hovered
    // L15: Echo's button:disabled - opacity .55, default cursor, no hover; a click does nothing (and isn't passed on)
    in property <bool> enabled: true;
    out property <bool> ctrl;       // Ctrl was held on the last press (Copy: Ctrl+click = the size menu)
    callback clicked;
    property <bool> hov: ta.has-hover && root.enabled;
    opacity: !root.enabled ? 0.55 : hov ? 1 : idle-opacity;
    animate opacity { duration: T.fade; }
    width: size;
    height: size;
    border-radius: 9px;
    background: hov ? T.panel2 : idle-bg;
    animate background { duration: T.fade; }
    // L49: Tab reaches the button (never a click: the page keeps the keys), Enter / Space press it, Echo's
    // :focus-visible ring (2 px accent2, 2 px out)
    fs := FocusScope {
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(e) => {
            // Esc: leave the button (the page / overlay gets the keys back) and let it go on up as well
            if (e.text == Key.Escape) {
                Focus.back();
                return reject;
            }
            if ((e.text == Key.Return || e.text == " ") && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta) {
                root.ctrl = false;
                root.clicked();
                return accept;
            }
            reject
        }
    }
    if fs.has-focus: Rectangle {
        x: -4px;
        y: -4px;
        width: root.width + 8px;
        height: root.height + 8px;
        border-radius: 13px;
        border-width: 2px;
        border-color: T.accent2;
    }
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.ctrl = e.modifiers.control;
            }
        }
    }
    TipArea {
        text: root.tip;
        hover: root.hov && !ta.pressed;
    }
    Icon {
        width: root.icon-size;
        height: root.icon-size;
        commands: root.icon;
        stroke: root.on ? T.hi : root.danger && root.hov ? T.bad : root.hov ? T.text : root.icon-color;
        fill: root.on ? T.hi : transparent;
        transform-scale: ta.pressed && root.enabled ? 0.88 : 1;
        animate transform-scale { duration: 90ms; }
    }
}

// Echo's .btn: 36 px, radius 10, border; .primary = gradient; .danger = red on hover; icon-only = square
export component Btn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> tip;
    in property <bool> primary;
    in property <bool> danger;      // red on hover
    in property <bool> delb;        // Echo's .delb: filled red (dialogs' Delete), lighter red on hover
    in property <bool> red;         // red icon always (Echo's delete in the player)
    in property <bool> active;      // yellow border + text (Echo's #ptrim.on)
    in property <bool> small;       // .btn.sm
    in property <length> text-size: 0px; // other text size (0 = the normal 14 / small 13)
    in property <bool> left-half;   // left part of a split button
    in property <bool> right-half;  // right part of a split button (chevron)
    in property <color> dot: transparent; // a coloured dot in front of the text (Echo's Record button)
    in property <bool> tip-above;   // tooltip above the button (the selection bar at the bottom)
    in property <float> idle-opacity: 1; // William: toolbar controls slightly see-through until hovered
    // Echo's #longbtn.on: red edge + pink text, the dot blinks (1 s) while a long recording runs
    in property <color> edge: transparent;
    in property <color> text-color: transparent;
    in property <bool> blink-dot;
    // small coloured text right after the label, centered with it (Echo's .ecplan .save "-17%" next to the year price)
    in property <string> badge;
    in property <color> badge-color: #a78bfa;
    // L15: Echo's button:disabled - opacity .55, default cursor, no hover; a click does nothing (and isn't passed on)
    in property <bool> enabled: true;
    out property <bool> ctrl;       // Ctrl was held on the last press (Copy: Ctrl+click = the size menu)
    callback clicked;
    property <bool> hov: ta.has-hover && root.enabled;
    opacity: !root.enabled ? 0.55 : hov ? 1 : idle-opacity;
    animate opacity { duration: T.fade; }
    height: small ? 30px : 36px;
    width: text == "" ? (right-half ? 30px : self.height) : hl.preferred-width;
    border-top-left-radius: right-half ? 0 : 10px;
    border-bottom-left-radius: right-half ? 0 : 10px;
    border-top-right-radius: left-half ? 0 : 10px;
    border-bottom-right-radius: left-half ? 0 : 10px;
    border-width: primary ? 0 : 1px;
    border-color: edge != transparent ? edge : delb ? (hov ? #ff7590 : T.bad) : active ? T.hi : danger && hov ? T.bad : hov ? T.hover : T.line;
    background: primary ? T.grad : delb ? (hov ? #ff7590 : T.bad) : hov ? T.panel2 : T.panel;
    drop-shadow-blur: primary ? 20px : 0;
    drop-shadow-offset-y: primary ? 6px : 0;
    drop-shadow-color: T.accent.with-alpha(0.25);
    animate background, border-color { duration: T.fade; }
    property <color> fg: text-color != transparent ? text-color : active ? T.hi : danger && hov ? T.bad : T.text;
    // L49: Tab reaches the button (never a click: the page keeps the keys), Enter / Space press it, Echo's
    // :focus-visible ring (2 px accent2, 2 px out)
    fs := FocusScope {
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(e) => {
            // Esc: leave the button (the page / overlay gets the keys back) and let it go on up as well
            if (e.text == Key.Escape) {
                Focus.back();
                return reject;
            }
            if ((e.text == Key.Return || e.text == " ") && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta) {
                root.ctrl = false;
                root.clicked();
                return accept;
            }
            reject
        }
    }
    if fs.has-focus: Rectangle {
        x: -4px;
        y: -4px;
        width: root.width + 8px;
        height: root.height + 8px;
        border-radius: 14px;
        border-width: 2px;
        border-color: T.accent2;
    }
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.ctrl = e.modifiers.control;
            }
        }
    }
    TipArea {
        text: root.tip;
        hover: root.hov && !ta.pressed;
        above: root.tip-above;
    }
    // brightness on hover for the primary button
    if root.primary && root.hov: Rectangle {
        border-radius: 10px;
        background: #ffffff1c;
    }
    hl := HorizontalLayout {
        padding-left: root.text == "" ? 0 : (root.small ? 11px : 15px);
        padding-right: root.text == "" ? 0 : (root.small ? 11px : 15px);
        spacing: 8px;
        alignment: center;
        transform-scale: ta.pressed && root.enabled ? 0.96 : 1;
        animate transform-scale { duration: 90ms; }
        if root.dot != transparent: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 9px;
            height: 9px;
            border-radius: 4.5px;
            background: root.dot;
            opacity: root.blink-dot && mod(animation-tick(), 1000ms) >= 500ms ? 0.2 : 1;
        }
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            width: root.right-half ? 13px : 16px;
            height: root.right-half ? 13px : 16px;
            stroke-width: root.right-half ? 2.4px : 1.8px;
            commands: root.icon;
            stroke: root.red ? T.bad : root.fg;
        }
        if root.text != "": Text {
            text: root.text;
            vertical-alignment: center;
            font-size: root.text-size > 0 ? root.text-size : root.small ? 13px : 14px;
            font-weight: (root.primary || root.delb ? 600 : 500) + T.fw;
            color: root.primary || root.delb ? white : root.fg;
        }
        if root.text != "" && root.badge != "": Text {
            text: root.badge;
            vertical-alignment: center;
            font-size: 11px;
            color: root.badge-color;
        }
    }
}

// a thin divider between the two halves of a split button
export component SplitLine inherits Rectangle {
    width: 1px;
    background: #ffffff22;
}

// Echo's .pill (header: recorder status, hotkeys)
export component Pill inherits Rectangle {
    in property <string> text;
    in property <color> dot: transparent;
    in property <length> max-w: 100000px; // r2-layout (L8): the header's pill elides past this
    height: 30px;
    width: min(hl.preferred-width, root.max-w);
    border-radius: 15px;
    background: T.panel;
    border-width: 1px;
    border-color: T.line;
    hl := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        if root.dot != transparent: Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - 8px) / 2;
            border-radius: 4px;
            background: root.dot;
        }
        Text {
            text: root.text;
            font-size: 12.5px;
            color: T.muted;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    // over the pill, not in its row: in the row a child (the recording pill's TouchArea) took a slot + 8 px of
    // spacing, which left empty space on the right (William, 9 Nov)
    @children
}

// Echo's kbd
export component Kbd inherits Rectangle {
    in property <string> text;
    height: 20px;
    width: kt.preferred-width + 12px;
    border-radius: 5px;
    background: T.panel2;
    border-width: 1px;
    border-color: T.hover;
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: T.hover;
        border-bottom-left-radius: 5px;
        border-bottom-right-radius: 5px;
    }
    kt := Text {
        y: 3px;
        text: root.text;
        font-family: "Segoe UI"; // Echo: kbd { font: 600 11px "Segoe UI" }
        font-size: 11px;
        font-weight: 600 + T.fw;
        color: T.text;
    }
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <brush> bg: #000000dd;
    height: 20px;
    width: bt.preferred-width + 14px;
    border-radius: 6px;
    background: bg;
    bt := Text {
        text: root.text;
        font-size: 11.5px;
        font-weight: 600 + T.fw;
        color: white;
    }
}

// Chat A: the Copy menu's sizes + default from Echo's settings (copy.rs fills it; right-click a size = default)
export global CopyCfg {
    in-out property <string> def: "full";
    in-out property <string> free: "20 MB";
    in-out property <string> basic: "50 MB";
    in-out property <string> nitro: "1 GB";
    in-out property <string> custom: "100 MB";
    callback set-default(string);
    // gaps-player (row 14): the sizes as numbers ("· fits" hints), the clip's size from its "22.7 MB" text, and the
    // Custom box (Echo's discord_custom_mb)
    in-out property <float> free-mb: 20;
    in-out property <float> basic-mb: 50;
    in-out property <float> nitro-mb: 1000;
    in-out property <float> custom-mb: 100;
    pure callback mb-of(string) -> float;
    callback set-custom(string);
}

// one line in a menu (copy sizes, sort)
export component MenuRow inherits Rectangle {
    in property <string> text;
    in property <string> right;
    in property <bool> on;      // tick in front
    in property <bool> tick-room;
    in property <string> badge; // e.g. "default"
    callback clicked;
    callback right-clicked;
    height: 36px;
    border-radius: 8px;
    background: ta.has-hover ? T.panel2 : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.right-clicked();
            }
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        if root.tick-room: Icon {
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
            commands: Ic.check;
            stroke: T.accent2;
            stroke-width: 2.2px;
            opacity: root.on ? 1 : 0;
        }
        Text {
            text: root.text;
            font-size: 13.5px;
            color: T.text;
            vertical-alignment: center;
            overflow: elide; // r2-layout (L26): a long name (mic, deep folder) ends in … instead of running out
        }
        if root.badge != "": Rectangle {
            y: (parent.height - self.height) / 2;
            height: 18px;
            width: bdt.preferred-width + 12px;
            border-radius: 9px;
            border-width: 1px;
            border-color: T.hi.with-alpha(0.4);
            bdt := Text {
                text: root.badge;
                font-size: 10.5px;
                color: T.hi;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.right != "": Text {
            text: root.right;
            font-size: 12.5px;
            color: T.muted;
            vertical-alignment: center;
        }
    }
}

// Echo's copy menu (sizes for Discord) - real (Chat A: copy.rs)
export component CopyMenuBody inherits Rectangle {
    in property <string> size-text;
    callback picked(string);
    callback cancel();      // Esc in the Custom box (close the menu)
    // the clip's size in MB (-1 = unknown: no "· fits" hints)
    property <float> clip-mb: root.size-text == "" ? -1 : CopyCfg.mb-of(root.size-text);
    pure function hint(t: string, mb: float) -> string {
        return t + (root.clip-mb >= 0 && root.clip-mb <= mb ? " · fits" : "");
    }
    width: 260px;
    height: vl.preferred-height;
    background: T.panel;
    border-radius: 12px;
    border-width: 1px;
    border-color: T.line;
    drop-shadow-blur: 40px;
    drop-shadow-offset-y: 14px;
    drop-shadow-color: #000000aa;
    TouchArea { }
    vl := VerticalLayout {
        padding: 6px;
        Text {
            text: "Copy · this clip is " + root.size-text;
            font-size: 11.5px;
            color: T.dim;
            height: 26px;
            vertical-alignment: center;
            x: 10px;
        }
        MenuRow {
            text: "Full size";
            badge: CopyCfg.def == "full" ? "default" : "";
            right: "original";
            clicked => { root.picked("full"); }
            right-clicked => { CopyCfg.set-default("full"); }
        }
        MenuRow {
            text: "Discord Free";
            badge: CopyCfg.def == "free" ? "default" : "";
            right: root.hint(CopyCfg.free, CopyCfg.free-mb);
            clicked => { root.picked("free"); }
            right-clicked => { CopyCfg.set-default("free"); }
        }
        MenuRow {
            text: "Nitro Basic";
            badge: CopyCfg.def == "basic" ? "default" : "";
            right: root.hint(CopyCfg.basic, CopyCfg.basic-mb);
            clicked => { root.picked("basic"); }
            right-clicked => { CopyCfg.set-default("basic"); }
        }
        MenuRow {
            text: "Nitro";
            badge: CopyCfg.def == "nitro" ? "default" : "";
            right: root.hint(CopyCfg.nitro, CopyCfg.nitro-mb);
            clicked => { root.picked("nitro"); }
            right-clicked => { CopyCfg.set-default("nitro"); }
        }
        // Echo's Custom row: a number box + "MB" - type a size, Enter copies (saved to discord_custom_mb)
        Rectangle {
            height: 36px;
            border-radius: 8px;
            background: cta.has-hover ? T.panel2 : transparent;
            cta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    cin.focus();
                    cin.select-all();
                }
                pointer-event(e) => {
                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                        CopyCfg.set-default("custom");
                    }
                }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                Text {
                    text: "Custom";
                    font-size: 13.5px;
                    color: T.text;
                    vertical-alignment: center;
                }
                if CopyCfg.def == "custom": Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 18px;
                    width: cbd.preferred-width + 12px;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: T.hi.with-alpha(0.4);
                    cbd := Text {
                        text: "default";
                        font-size: 10.5px;
                        color: T.hi;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 54px;
                    height: 24px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: cin.has-focus ? T.accent : T.line;
                    background: T.panel2;
                    TipArea {
                        text: "Type a size, then press Enter";
                        hover: cta.has-hover;
                    }
                    FocusScope {
                        // Esc closes the menu (it doesn't reach the player / library behind it)
                        key-pressed(e) => {
                            if (e.text == Key.Escape) {
                                root.cancel();
                                return accept;
                            }
                            reject
                        }
                        cin := TextInput {
                            x: 6px;
                            width: parent.width - 12px;
                            text: CopyCfg.custom-mb;
                            input-type: InputType.number;
                            single-line: true;
                            font-size: 12.5px;
                            color: T.text;
                            vertical-alignment: center;
                            selection-background-color: T.accent.with-alpha(0.45);
                            selection-foreground-color: T.text;
                            accepted => {
                                CopyCfg.set-custom(self.text);
                                root.picked("custom");
                            }
                            changed has-focus => {
                                if (!self.has-focus) {
                                    CopyCfg.set-custom(self.text);
                                }
                            }
                        }
                    }
                }
                Text {
                    text: "MB";
                    font-size: 12.5px;
                    color: T.muted;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle {
            height: 1px;
            background: T.line;
        }
        Text {
            text: "Right-click a size to make it the Copy default";
            font-size: 11.5px;
            color: T.dim;
            height: 26px;
            vertical-alignment: center;
            x: 10px;
        }
    }
}
