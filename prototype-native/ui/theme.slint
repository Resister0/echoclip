// Echo's look, ported from ui/index.html (:root variables, .btn, .ib, .cgrp, .pill, kbd, tooltips, toasts).
import { Focus } from "focus.slint"; // L49: Esc on a Tab-focused button hands the keys back

export global T {
    // text weight boost: Slint's OpenGL text has no ClearType/gamma boost, so Segoe UI looks ~10% thinner than
    // in Echo's WebView2. Rust sets this on Windows (default 50; ECHO_FONT_BOOST=<n> to try other values)
    in-out property <int> fw: 0;
    in-out property <color> bg: #0d0d10;
    in-out property <color> rail: #0a0a0c;
    in-out property <color> panel: #16161a;
    in-out property <color> panel2: #1e1e23;
    in-out property <color> line: #26262c;
    in-out property <color> hover: #34343c;
    in-out property <color> text: #f5f5f7;
    in-out property <color> muted: #a0a0ab;
    in-out property <color> dim: #6b6b76;
    in-out property <color> accent: #7c5cff;
    in-out property <color> accent2: #9d85ff;
    out property <color> ok: #34d399;
    out property <color> bad: #fb5c7c;
    in-out property <color> hi: #ffd23f; // progress, trim handles, favourites
    // the gradient's three colours (set by the theme); grad follows them
    in-out property <color> g0: #8b6cff;
    in-out property <color> g1: #6a4cf5;
    in-out property <color> g2: #4f7bff;
    out property <brush> grad: @linear-gradient(135deg, g0 0%, g1 55%, g2 100%);
    out property <length> radius: 14px;
    // Echo uses .15 s for buttons and .18 s for cards; the glow/shadow is NOT animated (it smeared into a trail)
    out property <duration> fade: 150ms;
    out property <duration> lift: 180ms;
}

