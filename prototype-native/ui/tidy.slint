// Chat D - Echo's #tidy dialog: clips saved twice, very short clips, the biggest ones. Favourites are never listed.
// Session cleanup (10 Nov 2026): + "Edit and original" and "In the cloud too"; saved twice keeps the latest clip.
// Rust (src/tidy.rs) fills the rows; the delete confirm is the normal dialog (DialogLayer sits ABOVE this layer).
import { T, Ic, Icon, Btn, IconBtn } from "theme.slint";
import { Focus } from "focus.slint"; // port leftovers L2

export struct TRow {
    kind: string,     // "head" (section title) / "gap" (space between groups) / "clip"
    title: string,    // head: "SAVED TWICE"; clip: shown name
    note: string,     // head: the note next to it; clip: "12.3 MB · 0:08 · 5 min ago · FiveM"
    idx: int,         // clip id
    on: bool,         // ticked
    keep: bool,       // the clip a "saved twice" group keeps (its tag is green)
    tag: string,      // "KEEP (latest)" / "ORIGINAL" / "EDIT" next to the name ("" = none)
    act: string,      // "" = delete as usual; "pc" = only the copy on this PC goes, its cloud copy stays
    group: int,       // clips of one "saved twice" group share a number (their border); -1 = in a plain list
    first: bool,      // first / last clip of its bordered box
    last: bool,
    thumb: image,
}

export global Tidy {
    in-out property <bool> open;
    in-out property <bool> busy;          // "Looking through your clips…"
    in-out property <[TRow]> rows;
    in-out property <string> sum;         // "3 clips · 120 MB"
    in-out property <int> n-on;
    in-out property <bool> cloud-box;     // show "Also delete their cloud copies"
    in-out property <bool> cloud-too: true;
    in-out property <string> bin: "Recycle Bin"; // "Trash" on Linux
    callback toggle(int);                 // row
    callback play(int);                   // clip id
    callback delete();
}

component TCheck inherits Rectangle {
    in property <bool> on;
    width: 17px;
    height: 17px;
    border-radius: 4px;
    border-width: 1.5px;
    border-color: on ? T.accent : T.muted;
    background: on ? T.accent : transparent;
    if on: Icon {
        width: 12px;
        height: 12px;
        commands: Ic.check;
        stroke: T.on-accent;
        stroke-width: 3px;
    }
}

export component TidyLayer inherits Rectangle {
    visible: Tidy.open;
    background: #000000aa;
    // L2: every way out (Esc, ×, click outside, Play) hands the keys back to the page
    changed visible => {
        if (!self.visible) {
            Focus.back();
        }
    }
    // click outside the panel = close
    TouchArea {
        clicked => { Tidy.open = false; }
    }
    public function take-focus() {
        tfs.focus();
    }
    tfs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                Tidy.open = false;
                return accept;
            }
            reject
        }
    }
    // .tp: 860 px max, panel, radius 16
    tp := Rectangle {
        width: min(860px, root.width - 56px);
        height: min(root.height - 56px, col.preferred-height);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: T.panel;
        border-radius: 16px;
        border-width: 1px;
        border-color: T.line;
        drop-shadow-blur: 80px;
        drop-shadow-offset-y: 30px;
        drop-shadow-color: #000000cc;
        clip: true;
        TouchArea { }   // clicks inside don't close it
        col := VerticalLayout {
            height: parent.height;
            // .th
            HorizontalLayout {
                padding-left: 22px;
                padding-right: 16px;
                padding-top: 18px;
                padding-bottom: 12px;
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: "Tidy up";
                        font-family: "Segoe UI Variable Display";
                        font-size: 19px;
                        font-weight: 700 + T.fw;
                        color: T.text;
                    }
                    Text {
                        text: "Clips saved twice, very short clips, edits and their originals, the biggest ones and clips that are in the cloud too. Favourites are never listed, and deleted clips go to the " + Tidy.bin + ".";
                        font-size: 13px;
                        color: T.muted;
                        wrap: word-wrap;
                    }
                }
                IconBtn {
                    icon: Ic.x;
                    tip: "Close";
                    clicked => { Tidy.open = false; }
                }
            }
            Rectangle {
                height: 1px;
                background: T.line;
            }
            // .tdb: the list (scrolls)
            Rectangle {
                vertical-stretch: 1;
                min-height: 120px;
                preferred-height: Tidy.busy || Tidy.rows.length == 0 ? 120px : body.preferred-height;
                if Tidy.busy || Tidy.rows.length == 0: Text {
                    text: Tidy.busy ? "Looking through your clips…" : "Nothing to tidy up - no clips saved twice, no very short ones.";
                    font-size: 14px;
                    color: T.muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Flickable {
                    visible: !Tidy.busy;
                    content-height: body.preferred-height;
                    body := VerticalLayout {
                        padding-left: 22px;
                        padding-right: 22px;
                        padding-top: 6px;
                        padding-bottom: 16px;
                        spacing: 0;
                        for r[i] in Tidy.rows: Rectangle {
                            height: r.kind == "head" ? 40px : r.kind == "gap" ? 8px : 66px + (r.first ? 4px : 0px) + (r.last ? 4px : 0px);
                            // section title (.ts h4: 11 px, letter-spaced, dim + a note)
                            if r.kind == "head": HorizontalLayout {
                                padding-top: 18px;
                                padding-bottom: 6px;
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: r.title;
                                    font-size: 11px;
                                    font-weight: 700 + T.fw;
                                    letter-spacing: 1px;
                                    color: T.dim;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: r.note;
                                    font-size: 11px;
                                    font-weight: 500 + T.fw;
                                    color: T.muted;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            // the bordered box around a group (.tg): drawn piece by piece per row
                            if r.kind == "clip": Rectangle {
                                border-width: 1px;
                                border-color: T.line;
                                border-top-left-radius: r.first ? 12px : 0;
                                border-top-right-radius: r.first ? 12px : 0;
                                border-bottom-left-radius: r.last ? 12px : 0;
                                border-bottom-right-radius: r.last ? 12px : 0;
                                y: r.first ? 0 : -1px;
                                height: parent.height + (r.first ? 0 : 1px);
                            }
                            if r.kind == "clip": Rectangle {
                                x: 4px;
                                y: r.first ? 4px : 0;
                                width: parent.width - 8px;
                                height: 66px;
                                border-radius: 9px;
                                background: rta.has-hover ? T.panel2 : transparent;
                                rta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { Tidy.toggle(i); }
                                }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 6px;
                                    padding-bottom: 6px;
                                    spacing: 12px;
                                    TCheck {
                                        y: (parent.height - self.height) / 2;
                                        on: r.on;
                                    }
                                    // .tt: 96 x 54 picture - click = play it
                                    Rectangle {
                                        width: 96px;
                                        height: 54px;
                                        border-radius: 7px;
                                        background: #000;
                                        clip: true;
                                        Image {
                                            width: 100%;
                                            height: 100%;
                                            source: r.thumb;
                                            image-fit: cover;
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { Tidy.play(r.idx); }
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            Text {
                                                text: r.title;
                                                font-size: 14px;
                                                font-weight: 600 + T.fw;
                                                color: T.text;
                                                overflow: elide;
                                            }
                                            if r.tag != "": Text {
                                                text: r.tag;
                                                font-size: 11px;
                                                font-weight: 700 + T.fw;
                                                color: r.keep ? #3ddc97 : T.dim;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: r.note;
                                            font-size: 12px;
                                            color: T.muted;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: T.line;
            }
            // .tf
            HorizontalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 12px;
                // Echo's <label class="chk">: the text ticks it too (PORT_LEFTOVERS L43)
                if Tidy.cloud-box: Rectangle {
                    width: chk.preferred-width;
                    chk := HorizontalLayout {
                        spacing: 8px;
                        TCheck {
                            y: (parent.height - self.height) / 2;
                            on: Tidy.cloud-too;
                        }
                        Text {
                            text: "Also delete their cloud copies";
                            font-size: 13px;
                            color: T.text;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Tidy.cloud-too = !Tidy.cloud-too; }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Text {
                    text: Tidy.sum;
                    font-size: 13px;
                    color: T.muted;
                    vertical-alignment: center;
                }
                Btn {
                    text: "Delete selected";
                    delb: Tidy.n-on > 0;
                    enabled: Tidy.n-on > 0; // L15: a real disabled state (was faked with opacity .45)
                    clicked => {
                        if (Tidy.n-on > 0) {
                            Tidy.delete();
                        }
                    }
                }
            }
        }
    }
}
