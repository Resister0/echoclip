// 11 Nov 2026: Echo's ONE play / pause button (Home's big clip, the player bar, anything else that shows a play state).
// A see-through dark circle + white glyph (reads on bright and dark frames, every theme), a vector glyph (crisp at
// every UI scale), a thin light edge, hover / press states. The play triangle is optically centred: its centroid sits on the circle's centre (the
// triangle's box is ~1/12 of its width right of centre - a box-centred triangle looks too far left).
import { T } from "theme.slint";

export global PlayIc {
    // 24 x 24 box (like Ic): play is symmetric about y = 12, centroid x = 12.37; pause = two bars, centred
    out property <string> play: "M8.7 5.5v13l11-6.5z";
    out property <string> pause: "M7.5 5h3.2v14H7.5z M13.3 5h3.2v14h-3.2z";
}

// the glyph alone (fill + a same-colour 1.5 px round-join stroke for soft corners - play only: on pause the stroke
// filled the gap between the bars at 18-28 px, it looked like a square)
export component PlayGlyph inherits Path {
    in property <bool> paused;
    in property <color> colour: T.on-accent;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.paused ? PlayIc.pause : PlayIc.play;
    fill: root.colour;
    stroke: root.colour;
    stroke-width: root.paused ? 0px : 1.5px;
    stroke-line-join: round;
}

// the round button: set `size`; `hover` / `pressed` from the owner's TouchArea (the badge takes no clicks itself, so
// the owner's own click / hover handling keeps working underneath it).
// 11 Nov 2026 (the user: "more minimal and smaller"): a see-through dark circle with a white triangle, like the calm
// play button of the player bar - no accent fill, no glow; hover brightens it a little.
export component PlayBadge inherits Rectangle {
    in property <length> size: 52px;
    in property <bool> paused;
    in property <bool> hover;
    in property <bool> pressed;
    width: root.size;
    height: root.size;
    Rectangle {
        width: root.size;
        height: root.size;
        border-radius: root.size / 2;
        background: root.pressed ? #000000c4 : root.hover ? #000000b3 : #000000a1;
        border-width: 1px;
        border-color: root.hover ? #ffffff59 : #ffffff38;
        drop-shadow-blur: root.size * 0.25;
        drop-shadow-color: #00000040;
        animate background, border-color { duration: T.fade; }
        transform-scale: root.pressed ? 0.95 : root.hover ? 1.04 : 1.0;
        animate transform-scale { duration: 120ms; easing: ease-out; }
        PlayGlyph {
            width: root.size * 0.46;
            height: root.size * 0.46;
            paused: root.paused;
            colour: root.hover ? #ffffff : #ffffffeb;
        }
    }
}
