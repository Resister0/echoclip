// Echo's #confirm dialog (confirmBox / choiceBox / askText): dark blurred backdrop, .dlg 400 px panel, title 17 px,
// muted message, buttons right-aligned. One global drives it; Rust opens it (main.rs ask()) and gets the answer.
import { T, Btn } from "theme.slint";

export struct DChoice {
    label: string,
    value: string,   // what answer() gets ("" = same as closing)
    kind: string,    // "" / "primary" / "delb" (filled red)
}

export global Dlg {
    in-out property <bool> open;
    in-out property <string> title;
    in-out property <string> msg;
    in-out property <[DChoice]> choices;
    in-out property <bool> input;          // askText: a text field under the message
    in-out property <string> placeholder;
    in-out property <string> text;         // the field's text (Rust reads it with the answer)
    in-out property <string> enter;        // the value Enter answers ("" = Enter does nothing - choiceBox)
    in-out property <bool> secret;         // Chat B: the field hides what's typed (cloud passwords)
    // gaps-settings: Echo's sendFeedback form - the field takes several lines (Enter = new line), a second field
    // (email) and a checkbox under it. Rust sets these right after ask() and clears `form` with the answer.
    in-out property <bool> form;
    in-out property <string> placeholder2;
    in-out property <string> text2;
    in-out property <bool> checked;
    in-out property <string> check-text;
    callback answer(string);               // "" = closed without choosing (Esc / click outside / Cancel)
}

export component DialogLayer inherits Rectangle {
    visible: Dlg.open;
    // #confirm: #000000d0 (+ blur, which Slint can't do)
    background: #000000d0;
    public function take-focus() {
        if (Dlg.input) {
            ti.focus();
        } else {
            fs.focus();
        }
    }
    // click outside = closed without choosing
    TouchArea {
        clicked => { Dlg.answer(""); }
    }
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                Dlg.answer("");
                return accept;
            }
            if (e.text == Key.Return && Dlg.enter != "") {
                Dlg.answer(Dlg.enter);
                return accept;
            }
            accept
        }
    }
    // .dlg: 400 px, panel, line border, radius 14, padding 22, shadow 0 20 60 #000c
    dlg := Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 400px;
        height: col.preferred-height;
        background: T.panel;
        border-radius: 14px;
        border-width: 1px;
        border-color: T.line;
        drop-shadow-blur: 60px;
        drop-shadow-offset-y: 20px;
        drop-shadow-color: #000000cc;
        TouchArea { }   // clicks inside don't close it
        col := VerticalLayout {
            padding: 22px;
            spacing: 0;
            Text {
                text: Dlg.title;
                font-family: "Segoe UI Variable Display";
                font-size: 17px;
                font-weight: 700 + T.fw;
                color: T.text;
                wrap: word-wrap;
            }
            Rectangle { height: 8px; }
            Text {
                text: Dlg.msg;
                font-size: 14px;
                color: T.muted;
                wrap: word-wrap;
            }
            // always there (an `if` would hide its id from take-focus), collapsed when not asked for
            VerticalLayout {
                visible: Dlg.input;
                padding-top: Dlg.input ? 12px : 0px;
                Rectangle {
                    // the form's message: Echo's textarea, 5 rows
                    height: !Dlg.input ? 0px : Dlg.form ? 104px : 36px;
                    clip: true;
                    background: T.panel2;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: ti.has-focus ? T.accent : T.line;
                    if ti.text == "": Text {
                        x: 10px;
                        y: Dlg.form ? 8px : 0px;
                        height: Dlg.form ? self.preferred-height : parent.height;
                        width: parent.width - 20px;
                        vertical-alignment: TextVerticalAlignment.center;
                        text: Dlg.placeholder;
                        font-size: Dlg.form ? 13px : 14px;
                        color: T.dim;
                        wrap: word-wrap;
                    }
                    ti := TextInput {
                        x: 10px;
                        y: Dlg.form ? 8px : 0px;
                        width: parent.width - 20px;
                        height: Dlg.form ? parent.height - 16px : parent.height;
                        vertical-alignment: Dlg.form ? TextVerticalAlignment.top : TextVerticalAlignment.center;
                        single-line: !Dlg.form;
                        wrap: Dlg.form ? TextWrap.word-wrap : TextWrap.no-wrap;
                        font-size: Dlg.form ? 13px : 14px;
                        color: T.text;
                        input-type: Dlg.secret ? InputType.password : InputType.text;
                        text <=> Dlg.text;
                        selection-background-color: T.accent.with-alpha(0.45);
                        key-pressed(e) => {
                            if (e.text == Key.Escape) {
                                Dlg.answer("");
                                return accept;
                            }
                            if (e.text == Key.Return && Dlg.enter != "" && !Dlg.form) {
                                Dlg.answer(Dlg.enter);
                                return accept;
                            }
                            reject
                        }
                    }
                }
                // the form's email line
                if Dlg.form: Rectangle {
                    height: 46px;
                    Rectangle {
                        y: 10px;
                        height: 36px;
                        clip: true;
                        background: T.panel2;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: ti2.has-focus ? T.accent : T.line;
                        if ti2.text == "": Text {
                            x: 10px;
                            height: parent.height;
                            vertical-alignment: center;
                            text: Dlg.placeholder2;
                            font-size: 13px;
                            color: T.dim;
                        }
                        ti2 := TextInput {
                            x: 10px;
                            width: parent.width - 20px;
                            height: parent.height;
                            vertical-alignment: center;
                            single-line: true;
                            font-size: 13px;
                            color: T.text;
                            input-type: InputType.text;
                            text <=> Dlg.text2;
                            selection-background-color: T.accent.with-alpha(0.45);
                            key-pressed(e) => {
                                if (e.text == Key.Escape) {
                                    Dlg.answer("");
                                    return accept;
                                }
                                if (e.text == Key.Return && Dlg.enter != "") {
                                    Dlg.answer(Dlg.enter);
                                    return accept;
                                }
                                reject
                            }
                        }
                    }
                }
                // the form's checkbox (Echo: 12.5 px, muted, box on the left)
                if Dlg.form: Rectangle {
                  height: chl.preferred-height;
                  chl := HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-top: 10px;
                    spacing: 8px;
                    Rectangle {
                        y: 2px;
                        width: 16px;
                        height: 16px;
                        border-radius: 4px;
                        border-width: Dlg.checked ? 0px : 1px;
                        border-color: T.line;
                        background: Dlg.checked ? T.accent : T.panel2;
                        Text {
                            visible: Dlg.checked;
                            text: "✓";
                            font-size: 11px;
                            color: T.on-accent;
                        }
                    }
                    Text {
                        text: Dlg.check-text;
                        font-size: 12.5px;
                        color: T.muted;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                  }
                  TouchArea {
                      mouse-cursor: pointer;
                      clicked => { Dlg.checked = !Dlg.checked; }
                  }
                }
            }
            Rectangle { height: 20px; }
            // .dbtn: right-aligned, gap 8
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                for c in Dlg.choices: Btn {
                    text: c.label;
                    primary: c.kind == "primary";
                    delb: c.kind == "delb";
                    clicked => { Dlg.answer(c.value); }
                }
            }
        }
    }
}
