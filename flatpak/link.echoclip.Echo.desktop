[Desktop Entry]
Type=Application
Name=Echo
GenericName=Game Clip Recorder
Comment=Save game highlights with one key
Exec=echo-clips
Icon=link.echoclip.Echo
Terminal=false
Categories=AudioVideo;Video;Recorder;
